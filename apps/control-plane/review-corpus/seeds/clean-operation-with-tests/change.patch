diff --git b/test/rename-item.test.ts b/test/rename-item.test.ts
new file mode 100644
index 0000000..25837d9
--- /dev/null
+++ b/test/rename-item.test.ts
@@ -0,0 +1,38 @@
+/** `todo/rename-item`, from the concept: the text of an item can change, by anyone working on its list. */
+import { afterAll, beforeAll, expect, it } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import type { ScopeHost } from '@substrat-run/kernel';
+import { buildHost, seed, type World } from '../src/seed.js';
+
+let dir: string;
+let host: ScopeHost;
+let world: World;
+let item: string;
+
+const as = (who: 'ada' | 'bjorn') => host.getScope(world[who].principal, world.tenant, world.scope);
+
+beforeAll(async () => {
+  dir = mkdtempSync(join(tmpdir(), 'todo-rename-item-'));
+  host = buildHost(dir);
+  world = await seed(host);
+  const ada = await as('ada');
+  const list = await ada.invoke<{ id: string }>('todo/create-list', { name: 'Weekend' });
+  item = (await ada.invoke<{ id: string }>('todo/add-item', { listId: list.id, text: 'mow' })).id;
+});
+
+afterAll(() => rmSync(dir, { recursive: true, force: true }));
+
+it('renames an item on a list the caller works on', async () => {
+  const renamed = await (await as('ada')).invoke<{ text: string }>('todo/rename-item', { itemId: item, text: 'mow the lawn' });
+  expect(renamed.text).toBe('mow the lawn');
+});
+
+it('refuses someone the list was never shared with', async () => {
+  await expect((await as('bjorn')).invoke('todo/rename-item', { itemId: item, text: 'nope' })).rejects.toMatchObject({ code: 'forbidden' });
+});
+
+it('answers not_found for an item that does not exist', async () => {
+  await expect((await as('ada')).invoke('todo/rename-item', { itemId: 'missing', text: 'x' })).rejects.toMatchObject({ code: 'not_found' });
+});
