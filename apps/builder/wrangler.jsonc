{
	"name": "substrat-builder",
	"main": "src/worker.ts",
	"compatibility_date": "2025-01-01",
	// The sandbox SDK imports node:path/posix; the worker itself stays node-free
	// (worker code imports builder-workspace/edge, never the node barrel).
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },

	// Staff-only (builder-studio.md §1.1): builder.substrat.net, same
	// custom-domain shape as console.substrat.net. Deliberately on the
	// substrat.net (brand) zone — the router's `*/*` claim is on substrat.run,
	// so there is no route to fight.
	"routes": [{ "pattern": "builder.substrat.net", "custom_domain": true }],

	// EVERYTHING through the worker: the SPA shell itself is staff-only, so
	// assets are behind the auth gate too — unlike the dashboard, which scopes
	// run_worker_first to /api/*. Unknown paths (team-slug deep links like
	// /acme-x1y2z3) fall back to index.html so the client router resolves them.
	"assets": {
		"directory": "web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},

	// The shared control plane — membership lookups (which teams does this
	// login build for), authenticated with CP_SERVICE_TOKEN like the dashboard.
	"services": [{ "binding": "CONTROL_PLANE_SVC", "service": "substrat-control-plane" }],

	"durable_objects": {
		"bindings": [
			{ "name": "BUILDER_AGENT", "class_name": "BuilderAgent" },
			{ "name": "Sandbox", "class_name": "Sandbox" },
			// The studio's own kernel scope (#646): one CP-less ScopeDO bundling
			// only the metering engine — token usage per turn lands here.
			{ "name": "SCOPE", "class_name": "ScopeDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["BuilderAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
		{ "tag": "v3", "new_sqlite_classes": ["ScopeDO"] }
	],

	// The execution container (#626): the monorepo baked warm — see
	// builder.Dockerfile at the repo root (context must be the monorepo).
	// standard-3 per builder-studio.md §4.1: pnpm + tsc + vitest + two dev
	// servers do not fit below 8 GiB. Image version pins to @cloudflare/sandbox.
	//
	// rollout_active_grace_period (#3259): a release's container rollout leaves alone any
	// sandbox connected to its Durable Object for less than this many seconds. Every source
	// build starts a sandbox of its own (`build:<buildId>`), so with the default of 0 a
	// rollout SIGTERMs a build that started moments before it, and the build's running
	// command dies with the sandbox's control server — ours in a release, and a tenant's
	// push that lands during one. An hour is above the longest a build holds its sandbox
	// (test/rollout-grace.test.ts derives the bound). Older sandboxes are still replaced;
	// a younger one keeps the previous image until it ends or ages past the window.
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "../../builder.Dockerfile",
			"instance_type": "standard-3",
			"max_instances": 50,
			"rollout_active_grace_period": 3600
		}
	],

	// D-66: Git-compatible hosted source. Project/session metadata stays in the agent DO.
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "substrat-projects" }],

	// The control plane's auth DB — READ-ONLY roster lookups (staff_actor).
	// Same database the console consults; the builder never writes to it.
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "substrat-control-plane-auth",
			"database_id": "${CF_D1_AUTH_DB_ID}"
		}
	],

	// The source build service has an isolated test environment; it never reaches prod repos.
	"env": {
		"test": {
			"routes": [],
			"workers_dev": true,
			"services": [{ "binding": "CONTROL_PLANE_SVC", "service": "substrat-control-plane-test" }],
			"durable_objects": { "bindings": [
				{ "name": "BUILDER_AGENT", "class_name": "BuilderAgent" },
				{ "name": "Sandbox", "class_name": "Sandbox" },
				{ "name": "SCOPE", "class_name": "ScopeDO" }
			] },
			"containers": [{ "class_name": "Sandbox", "image": "../../builder.Dockerfile", "instance_type": "standard-3", "max_instances": 50, "rollout_active_grace_period": 3600 }],
			"artifacts": [{ "binding": "ARTIFACTS", "namespace": "substrat-projects-test" }],
			"d1_databases": [{ "binding": "AUTH_DB", "database_name": "substrat-control-plane-auth-test", "database_id": "${CF_D1_AUTH_DB_ID_TEST}" }]
		}
	}

	// Secrets (scripts/secrets.mjs, secrets/platform.<env>.env):
	//   OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, SESSION_SECRET,
	//   CP_SERVICE_TOKEN (= the control plane's SERVICE_TOKEN)
	// Provider keys (ANTHROPIC_API_KEY etc.) arrive with #626 — the shell
	// holds no model credentials at all.
	// The staff check reads the roster only for an address the issuer asserted
	// `email_verified: true` (#1359), with nothing set. The break-glass, for an issuer
	// that does not send the claim, is a var that logs on every address it admits:
	//   "OIDC_ALLOW_UNVERIFIED_EMAIL": "true"
}
