{
	"name": "substrat-builder",
	"main": "src/worker.ts",
	"compatibility_date": "2025-01-01",
	// The sandbox SDK imports node:path/posix; the worker itself stays node-free
	// (worker code imports builder-workspace/edge, never the node barrel).
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },

	// Staff-only (builder-studio.md §1.1): builder.substrat.net, same
	// custom-domain shape as console.substrat.net. Deliberately on the
	// substrat.net (brand) zone — the router's `*/*` claim is on substrat.run,
	// so there is no route to fight.
	"routes": [{ "pattern": "builder.substrat.net", "custom_domain": true }],

	// EVERYTHING through the worker: the SPA shell itself is staff-only, so
	// assets are behind the auth gate too — unlike the dashboard, which scopes
	// run_worker_first to /api/*.
	"assets": {
		"directory": "web/dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},

	"durable_objects": {
		"bindings": [
			{ "name": "BUILDER_AGENT", "class_name": "BuilderAgent" },
			{ "name": "Sandbox", "class_name": "Sandbox" },
			// The studio's own kernel scope (#646): one CP-less ScopeDO bundling
			// only the metering engine — token usage per turn lands here.
			{ "name": "SCOPE", "class_name": "ScopeDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["BuilderAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
		{ "tag": "v3", "new_sqlite_classes": ["ScopeDO"] }
	],

	// The execution container (#626): the monorepo baked warm — see
	// builder.Dockerfile at the repo root (context must be the monorepo).
	// standard-3 per builder-studio.md §4.1: pnpm + tsc + vitest + two dev
	// servers do not fit below 8 GiB. Image version pins to @cloudflare/sandbox.
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "../../builder.Dockerfile",
			"instance_type": "standard-3",
			"max_instances": 4
		}
	],

	// D-52 (#627): one bare repo per project, as ULID-keyed git bundles in R2 —
	// the durable tier that survives container sleep. R2 has NO object
	// versioning (verified), so the rollback trail is app-level: last N bundles
	// kept per project, pruned on save.
	"r2_buckets": [
		{ "binding": "PROJECT_REPOS", "bucket_name": "substrat-builder-repos" }
	],

	// The control plane's auth DB — READ-ONLY roster lookups (staff_actor).
	// Same database the console consults; the builder never writes to it.
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "substrat-control-plane-auth",
			"database_id": "da63a4b0-3b45-474f-bce0-1cbe18080906"
		}
	]

	// Secrets (scripts/secrets.mjs, secrets/platform.<env>.env):
	//   OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, SESSION_SECRET
	// Provider keys (ANTHROPIC_API_KEY etc.) arrive with #626 — the shell
	// holds no model credentials at all.
}
