{
  "name": "@substrat-run/builder",
  "version": "0.11.1",
  "private": true,
  "description": "The builder studio — chat → vertical. Terminal driver today; Worker + chat pane to come (builder-studio.md §7).",
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "ui": "concurrently -k -n api,web -c yellow,cyan \"tsx src/server.ts\" \"pnpm --filter @substrat-run/builder-web dev\"",
    "api": "tsx src/server.ts",
    "gates": "tsx src/gates-cli.ts",
    "evals": "tsx src/evals-cli.ts",
    "models": "tsx src/models-cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json",
    "cf:deploy": "pnpm --filter @substrat-run/builder-web build && node ../../tools/wrangler-config.mjs --app builder && wrangler deploy -c wrangler.generated.jsonc",
    "test": "vitest run",
    "cf:deploy:test": "pnpm --filter @substrat-run/builder-web build && node ../../tools/wrangler-config.mjs --app builder --env test && wrangler deploy -c wrangler.generated.jsonc --env test"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.14",
    "@substrat-run/adapter-cloudflare": "workspace:*",
    "@substrat-run/builder-generator": "workspace:*",
    "@substrat-run/builder-workspace": "workspace:*",
    "@substrat-run/cli": "workspace:*",
    "@substrat-run/contracts": "workspace:*",
    "@substrat-run/control-plane-api": "workspace:*",
    "@substrat-run/engine-assistant": "workspace:*",
    "@substrat-run/engine-metering": "workspace:*",
    "@substrat-run/kernel": "workspace:*",
    "@substrat-run/model-providers": "workspace:*",
    "@substrat-run/oidc-rp": "workspace:*",
    "ai": "7.0.159",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.307",
    "@anthropic-ai/sdk": "1.1.0",
    "@cloudflare/workers-types": "catalog:",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@substrat-run/adapter-sqlite": "workspace:*",
    "@types/node": "catalog:",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
