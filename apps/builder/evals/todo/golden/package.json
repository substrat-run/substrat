{
  "name": "shared-lists",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "substrat": {
    "slug": "shared-lists",
    "name": "Shared Lists",
    "sendsEmail": true,
    "permissions": "src/provision.ts",
    "runtimeNeeds": {
      "entry": "src/worker.ts",
      "stores": [
        {
          "binding": "SCOPE",
          "class": "ScopeDO"
        },
        {
          "binding": "SWEEPER",
          "class": "SweeperDO"
        },
        {
          "binding": "AUTH",
          "class": "IdentityDO"
        }
      ]
    },
    "devServers": [
      {
        "name": "issuer",
        "run": "issuer",
        "portEnv": "ISSUER_PORT",
        "portFrom": "src/server.ts"
      },
      {
        "name": "api",
        "run": "server",
        "portEnv": "PORT",
        "portFrom": "src/server.ts"
      }
    ]
  },
  "scripts": {
    "dev": "concurrently -n issuer,api -c magenta,blue \"pnpm run issuer\" \"tsx watch src/server.ts\"",
    "issuer": "substrat-dev-issuer --personas src/personas.ts",
    "server": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint:boundaries": "substrat-boundary-lint"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@substrat-run/adapter-cloudflare": "^0.187.0",
    "@substrat-run/adapter-sqlite": "^0.187.0",
    "@substrat-run/attachment-extractors": "^0.2.48",
    "@substrat-run/contracts": "^0.187.0",
    "@substrat-run/engine-invoicing": "^0.11.71",
    "@substrat-run/engine-workorder": "^0.13.12",
    "@substrat-run/kernel": "^0.187.0",
    "@substrat-run/vertical-host": "^0.187.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@substrat-run/boundary-lint": "^0.8.2",
    "@substrat-run/dev-issuer": "^0.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@10.10.0"
}
