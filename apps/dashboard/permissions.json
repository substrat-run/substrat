{
  "permissions": [
    {
      "key": "dashboard:manage-integrations",
      "description": "Connect and disconnect third-party providers (GitHub, Scrive) for this tenant",
      "declaredBy": [
        "@substrat-run/dashboard"
      ]
    },
    {
      "key": "dashboard:manage-members",
      "description": "Invite and remove team members and see the roster",
      "declaredBy": [
        "@substrat-run/dashboard"
      ]
    },
    {
      "key": "dashboard:provision-app",
      "description": "Provision and manage apps (vertical instances) in this tenant — the tenant admin",
      "declaredBy": [
        "@substrat-run/dashboard"
      ]
    },
    {
      "key": "dashboard:read",
      "description": "Read the tenant’s apps",
      "declaredBy": [
        "@substrat-run/dashboard"
      ]
    },
    {
      "key": "invites:read",
      "description": "List invitations and their state",
      "declaredBy": [
        "@substrat-run/engine-invites"
      ]
    },
    {
      "key": "invites:revoke",
      "description": "Withdraw an invitation before it is accepted",
      "declaredBy": [
        "@substrat-run/engine-invites"
      ]
    },
    {
      "key": "invites:send",
      "description": "Invite someone to an organization",
      "declaredBy": [
        "@substrat-run/engine-invites"
      ]
    }
  ],
  "roles": [
    {
      "key": "admin",
      "permissions": [
        "dashboard:manage-integrations",
        "dashboard:manage-members",
        "dashboard:provision-app",
        "dashboard:read",
        "invites:read",
        "invites:revoke",
        "invites:send"
      ],
      "source": "vertical"
    },
    {
      "key": "member",
      "permissions": [
        "dashboard:provision-app",
        "dashboard:read"
      ],
      "source": "vertical"
    },
    {
      "key": "owner",
      "permissions": [
        "dashboard:manage-integrations",
        "dashboard:manage-members",
        "dashboard:provision-app",
        "dashboard:read",
        "invites:read",
        "invites:revoke",
        "invites:send"
      ],
      "source": "vertical"
    },
    {
      "key": "viewer",
      "permissions": [
        "dashboard:read"
      ],
      "source": "vertical"
    }
  ],
  "entityGrants": []
}
