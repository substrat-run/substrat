{
  "name": "@substrat-run/dashboard",
  "version": "0.48.7",
  "private": true,
  "substrat": {
    "permissions": "src/provision.ts",
    "client": {
      "model": "src/routes.ts",
      "operations": "dashboardRoutes",
      "schemas": {
        "AdminLogEntry": "adminLogRow",
        "AppDeployments": "appDeploymentsView",
        "AppEvent": "appEvent",
        "AppFailuresView": "appFailuresView",
        "AppMetricsView": "appMetricsView",
        "AppOverlays": "appOverlaysView",
        "AppRow": "appRow",
        "BoundScopeRow": "boundScopeRow",
        "BusinessVolumesView": "businessVolumesView",
        "CatalogEntry": "catalogRow",
        "ChannelHistoryRow": "channelHistoryRow",
        "ConnectorCallsView": "connectorCallsView",
        "DeployFailureRow": "deployFailureRow",
        "DeploymentRow": "deploymentRow",
        "DeploymentVersion": "deploymentVersion",
        "ExplanationView": "explanationView",
        "EventEffects": "eventEffects",
        "FailureGroupRow": "failureGroupRow",
        "FieldCoverageView": "fieldCoverageView",
        "FieldReadsView": "fieldReadsView",
        "FindingEntry": "findingRow",
        "FindingRuleEntry": "findingRuleRow",
        "FlowView": "appFlowView",
        "InstallStep": "installStep",
        "LogPatterns": "logPatternsView",
        "Member": "memberRow",
        "MoveReviewRow": "moveReviewRow",
        "ObservabilityRow": "observabilityRow",
        "PreviewCreated": "previewCreated",
        "PreviewDomainRow": "previewDomainRow",
        "PreviewRow": "previewRow",
        "PromotionReviewRow": "promotionReviewRow",
        "ReleaseRow": "releaseRow",
        "ReleasesView": "releasesView",
        "RequestFacets": "requestFacetsView",
        "RequestVolume": "requestVolumeView",
        "TeamTrafficSeries": "teamTrafficSeries",
        "TenantMetricsRow": "tenantMetricsRow",
        "TrafficSeries": "trafficSeries"
      },
      "out": "web/src/lib/api.generated.ts",
      "name": "Dashboard"
    }
  },
  "description": "The Dashboard — Substrat’s tenant-facing self-service surface (the platform vertical). See docs/architecture/dashboard.md.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "build:web": "pnpm --filter @substrat-run/dashboard-web build",
    "cf:dev": "wrangler dev --var STANDALONE:true --port 8890",
    "cf:deploy": "pnpm run build:web && node ../../tools/preflight-migrations.mjs && wrangler deploy",
    "cf:deploy:test": "pnpm run build:web && node ../../tools/preflight-migrations.mjs --env test && wrangler deploy --env test"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@substrat-run/adapter-cloudflare": "workspace:^",
    "@substrat-run/adapter-email": "workspace:^",
    "@substrat-run/connector-fortnox": "workspace:^",
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/control-plane-api": "workspace:^",
    "@substrat-run/control-plane-client": "workspace:^",
    "@substrat-run/engine-invites": "workspace:^",
    "@substrat-run/engine-protocol": "workspace:^",
    "@substrat-run/kernel": "workspace:^",
    "@substrat-run/model-providers": "workspace:^",
    "@substrat-run/oidc-rp": "workspace:^",
    "@substrat-run/vertical-host": "workspace:^",
    "hono": "catalog:",
    "tweetnacl": "^1.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@substrat-run/adapter-sqlite": "workspace:^",
    "@substrat-run/demo-meridian": "workspace:^",
    "@substrat-run/engine-absence": "workspace:^",
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260310.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
