{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // node for the suites, which run on node (`node:crypto`, `Buffer`); the worker entry has
    // its own config without it (tsconfig.worker.json).
    "types": [
      "@cloudflare/workers-types",
      "node"
    ]
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "src/worker.ts"
  ]
}
