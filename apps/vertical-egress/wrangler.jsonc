{
	"name": "substrat-vertical-egress",
	"main": "src/worker.ts",
	"compatibility_date": "2025-01-01",

	// Two bindings, both to the router, as services (a direct in-process call, not an edge
	// subrequest).
	//
	// ROUTER: platform-bound egress from any dispatched vertical loops back through here so it
	// re-enters resolution+dispatch instead of 522-ing at the same-zone edge (#442).
	// PEER_CALLS: the router's `PeerCalls` entrypoint (#1706) — a peer call is an RPC, not an
	// HTTP forward, because what crosses is the CALLER the router set as this dispatch's
	// parameters. A named entrypoint is reachable only through a binding like this one, which
	// is what keeps a dispatched vertical from addressing it directly.
	"services": [
		{ "binding": "ROUTER", "service": "substrat-router" },
		{ "binding": "PEER_CALLS", "service": "substrat-router", "entrypoint": "PeerCalls" }
	],

	// What counts as "our own zone" — same var + meaning as the control plane. Any host that
	// is or ends in one of these goes to the router; everything else passes through to the
	// internet.
	//
	// PLATFORM_CP_URL is the same var the control plane carries, and must hold the same value:
	// it is the origin the CP injects into every pushed vertical as CONTROL_PLANE_URL, and it
	// is NOT under PLATFORM_BASE_DOMAINS. Without it here, a vertical calling the relay it was
	// handed the address of is refused by its own outbound policy (#981).
	"vars": {
		"PLATFORM_BASE_DOMAINS": "substrat.run",
		"PLATFORM_CP_URL": "https://console.substrat.net"
	},

	// Egress metering (#303, D-30 "meter, don't bill"): one datapoint per subrequest
	// decision — index = vertical slug; blobs = [hostname, verdict, tenant]. This is what
	// keeps the unenforced tail (pre-#303 versions) and refusal spikes visible.
	"analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "substrat_egress" }],

	// No public route and no workers.dev hostname: this worker is only ever reached as the
	// dispatch namespace's outbound worker, never addressed directly.
	"workers_dev": false,

	"observability": { "enabled": true },

	"env": {
		"test": {
			// The router's test deployment is `substrat-router-test` (wrangler suffixes the env).
			"services": [
				{ "binding": "ROUTER", "service": "substrat-router-test" },
				{ "binding": "PEER_CALLS", "service": "substrat-router-test", "entrypoint": "PeerCalls" }
			], // differs
			// Test hosts (`*.global.test.substrat.run`) still end in `substrat.run`, so the same
			// base-domain match routes them; the differing ROUTER binding keeps test loops off prod.
			// The relay origin DOES differ per environment — it is the test control plane's own
			// custom domain — and must match `PLATFORM_CP_URL` in apps/control-plane's test env.
			"vars": {
				"PLATFORM_BASE_DOMAINS": "substrat.run",
				"PLATFORM_CP_URL": "https://console-test.substrat.net" // differs
			},
			"analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "substrat_egress_test" }], // differs: test data stays out of prod charts
			"workers_dev": false,
			"observability": { "enabled": true }
		}
	}
}
