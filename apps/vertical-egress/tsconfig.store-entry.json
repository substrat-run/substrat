{
  // The platform's store entry and its test driver (packages/control-plane-api/store-entry,
  // #2289) run in workerd and are bundled, never emitted, by tools/store-entry-emit.mts. They
  // are typechecked here, the package whose suites run them, because this one has the workers
  // types and control-plane-api's node build does not.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "../..",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["../../packages/control-plane-api/store-entry/*.ts"]
}
