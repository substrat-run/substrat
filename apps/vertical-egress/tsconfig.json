{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "test"],
  // #2254's fixture workers import the router's and the kernel's source across this rootDir,
  // which tsc refuses here; vitest bundles them. Out until they import through packages.
  // store-fence.model.test.ts does too, and tsconfig.store-entry.json typechecks it.
  "exclude": ["test/store-hop-entry.ts", "test/store-fence.model.test.ts"]
}
