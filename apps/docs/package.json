    "markdown-it": "^14.1.0",
    "mermaid": "^11.16.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
