/** The heading the figure carries, kept beside the data it describes. */
export const head = {
  label: 'the path',
  lede: 'Six guards, in the order they fire.',
};

/**
 * Markup the figure wants, rendered as the markdown the twin wants.
 *
 * Mapped rather than stripped (the sibling LayerStack strips, which is fine for
 * prose that carries no code): `ScopeId` and `ctx.sql` are the substance of these
 * sentences, and a twin that flattens them to bare words reads as if the rule were
 * about the English word rather than the symbol.
 */
const plain = (html: string) =>
  html
    .replace(/<code>([^<]*)<\/code>/g, '`$1`')
    .replace(/<em>([^<]*)<\/em>/g, '*$1*')
    .replace(/<(?:b|strong)>([^<]*)<\/(?:b|strong)>/g, '**$1**')
    .replace(/\s+/g, ' ')
    .trim();

export function alt(): string {
  return [
    `**Diagram — ${head.label}.** ${head.lede} Each stage can stop a change, and the ` +
      'claim is that a mistake surviving one meets the next.',
    '',
    ...guards.map(
      (g, i) =>
        `${i + 1}. **${g.when} — ${g.title}.** ${plain(g.body)}\n` +
        `   - *Stops:* ${g.stops}`,
    ),
  ].join('\n');
}
