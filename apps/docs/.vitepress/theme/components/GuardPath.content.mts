/**
 * Every string GuardPath renders, and the markdown twin of the same facts.
 *
 * As with its siblings: a fact typed into the template renders on the page and
 * vanishes from llms.txt. Put it here. See ./LayerStack.content.mts.
 *
 * The ordering is load-bearing and is not decoration. These are not layers of a
 * picture — they are stages a commit passes through in time, each able to stop
 * it, and the claim the page makes is that a mistake surviving one meets the
 * next. Reordering them makes the page say something false.
 */

/** One stage on the path a change takes. `body` carries inline `<code>`/`<em>`. */
export interface Guard {
  /** When it fires — the stage name, not a category. */
  readonly when: string;
  readonly title: string;
  readonly body: string;
  /** What a reader loses if this stage is missing. */
  readonly stops: string;
}

