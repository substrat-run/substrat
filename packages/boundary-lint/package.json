{
  "name": "@substrat-run/boundary-lint",
  "version": "0.4.1",
  "description": "The Substrat layer rules, enforced mechanically — R1–R7 static analysis for module code, in this monorepo or in a standalone vertical",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrat-run/substrat.git",
    "directory": "packages/boundary-lint"
  },
  "homepage": "https://substrat.net/concepts/modules",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "substrat-boundary-lint": "./bin/substrat-boundary-lint.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
