{
  "name": "@substrat-run/elements",
  "version": "0.4.0",
  "description": "Substrat's web components: Lit elements on Web Awesome's free core, themed through its --wa-* tokens, with the model-bound pieces (an entity table first) a vertical drops in",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrat-run/substrat.git",
    "directory": "packages/elements"
  },
  "homepage": "https://substrat.net/reference/elements",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "default": "./dist/avatar.js"
    },
    "./user-menu": {
      "types": "./dist/user-menu.d.ts",
      "default": "./dist/user-menu.js"
    },
    "./entity-table": {
      "types": "./dist/entity-table.d.ts",
      "default": "./dist/entity-table.js"
    },
    "./entity-table-model": {
      "types": "./dist/entity-table-model.d.ts",
      "default": "./dist/entity-table-model.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "default": "./dist/controls.js"
    },
    "./jsx": {
      "types": "./dist/jsx.d.ts",
      "default": "./dist/jsx.js"
    },
    "./themes/*": "./dist/themes/*"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/themes','dist/themes',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../tools/publish-guard.mjs"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
