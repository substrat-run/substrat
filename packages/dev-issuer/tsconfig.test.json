// Typecheck of src + test. The build tsconfig emits from `src` alone, which left every
// file under `test/` compiled by nobody — vitest transpiles without checking, so a test
// could reference a symbol that no longer exists and stay green (#989).
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    // DOM for `RequestInfo` — the test patches `globalThis.fetch`.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src", "test"]
}
