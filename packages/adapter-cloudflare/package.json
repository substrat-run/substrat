{
  "name": "@substrat-run/adapter-cloudflare",
  "version": "0.171.0",
  "description": "Cloudflare Durable-Object scope host (D-14): DO-per-scope, real kernel semantics on Workers",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrat-run/substrat.git",
    "directory": "packages/adapter-cloudflare"
  },
  "homepage": "https://substrat.net/reference/adapter-cloudflare",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routing": {
      "types": "./dist/route-resolver.d.ts",
      "default": "./dist/route-resolver.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run && vitest run -c vitest.supplied-sweeper.config.ts",
    "test:contract-hosts": "vitest run test/contract-hosts.test.ts",
    "test:contract-switch": "vitest run test/contract-switch.test.ts",
    "test:contract-data": "vitest run test/contract-data.test.ts",
    "test:rest-1": "vitest run --exclude test/contract-hosts.test.ts --exclude test/contract-switch.test.ts --exclude test/contract-data.test.ts --shard=1/2",
    "test:rest-2": "vitest run --exclude test/contract-hosts.test.ts --exclude test/contract-switch.test.ts --exclude test/contract-data.test.ts --shard=2/2 && vitest run -c vitest.supplied-sweeper.config.ts",
    "prepublishOnly": "node ../../tools/publish-guard.mjs"
  },
  "dependencies": {
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/kernel": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@substrat-run/attachment-extractors": "workspace:^",
    "@substrat-run/cli": "workspace:^",
    "@substrat-run/contract-tests": "workspace:^",
    "@substrat-run/control-plane-api": "workspace:^",
    "@substrat-run/vertical-auth": "workspace:^",
    "@substrat-run/vertical-host": "workspace:^",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
