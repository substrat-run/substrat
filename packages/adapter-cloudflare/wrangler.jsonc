{
  "name": "substrat-adapter-cloudflare",
  "main": "test/worker.ts",
  "compatibility_date": "2025-01-01",
  // #1242: in production this arrives as a plain_text binding the deploy injects
  // (control-plane-api/src/wfp.ts); here it is a var so version-stamp.test.ts can
  // assert every emitted outbox row carries it. Env is script-wide, so the
  // NULL-when-unconfigured half lives in adapter-sqlite's twin test instead.
  "vars": { "SUBSTRAT_VERSION_ID": "01JTESTVRSN0000000000000AA" },
  "durable_objects": {
    "bindings": [
      { "name": "SCOPE", "class_name": "ScopeDO" },
      { "name": "CONTROL_PLANE", "class_name": "ControlPlaneDO" },
      // #1899: every directory binding below names its OWN ControlPlaneDO subclass, and its
      // scopes a class that reads it — a second binding to one class is the same directory
      // (test/worker.ts says why).
      // The schedule suite's directory (contract.test.ts) — its sweep counts every active scope.
      { "name": "SCHED_CONTROL_PLANE", "class_name": "SchedControlPlaneDO" },
      // …and its scopes, whose class reads SCHED_CONTROL_PLANE as its CONTROL_PLANE (onDirectory
      // in test/worker.ts). Every harness with a directory of its own has scopes that read it.
      { "name": "SCHED_SCOPE", "class_name": "SchedScopeDO" },
      // Scopes whose migration fails closed — see test/worker.ts.
      { "name": "BROKEN_SCOPE", "class_name": "BrokenScopeDO" },
      // The alarm-driven platform-sweep trigger — see platform-sweeper.test.ts.
      { "name": "SWEEPER", "class_name": "SweeperDO" },
      // …and one whose every pass throws whole (the loop must survive re-armed).
      { "name": "BROKEN_SWEEPER", "class_name": "BrokenSweeperDO" },
      // The sweeper tests' OWN directory + scope namespaces (each its own class, #1899).
      // vitest-pool-workers re-patches the worker's module graph between test
      // files, invalidating live DO instances — if these tests instantiated the
      // contract suites' 'control-plane' singleton, the suite that runs next
      // would find a stale object and fail with "changed, invalidating this
      // Durable Object". Separate namespaces = separate objects = no collision.
      { "name": "SWEEP_SCOPE", "class_name": "SweepScopeDO" },
      { "name": "SWEEP_CONTROL_PLANE", "class_name": "SweepControlPlaneDO" },
      // The CP-less scope-local sweep trigger (#461) + its own scope namespace
      // — see scope-sweeper.test.ts (same isolation reasoning as SWEEP_SCOPE).
      { "name": "SCOPE_SWEEPER", "class_name": "ScopeSweeperDO" },
      { "name": "LOCAL_SWEEP_SCOPE", "class_name": "ScopeDO" },
      // #938: live reads. Its OWN class (only `liveMod` is registered, so only this
      // class declares a `liveTargets` entity) and its own namespace, for the same
      // isolation reason SWEEP_SCOPE has one.
      { "name": "LIVE_SCOPE", "class_name": "LiveScopeDO" },
      // #2055: a scope class whose one module's consumer can be held mid-handler.
      { "name": "CAUSED_BY_SCOPE", "class_name": "CausedByScopeDO" },
      // #1705: the cross-vertical suite's two deployments, one class per vertical, over a
      // directory of their own (the sweep enumerates every active scope in its directory,
      // and must not walk every other suite's).
      { "name": "CRM_SCOPE", "class_name": "CrmScopeDO" },
      { "name": "BOARD_SCOPE", "class_name": "BoardScopeDO" },
      { "name": "VE_CONTROL_PLANE", "class_name": "VeControlPlaneDO" },
      // #1710: three pushed versions of one vertical. Hosted, each is its own script, and a
      // Durable Object namespace belongs to its script, so each gets its own CLASS here (a
      // second binding to the same class would share one namespace and prove nothing). The
      // directory the control-plane API runs over is its own too.
      { "name": "PC_V1_SCOPE", "class_name": "PreviewV1ScopeDO" },
      { "name": "PC_V2_SCOPE", "class_name": "PreviewV2ScopeDO" },
      { "name": "PC_V3_SCOPE", "class_name": "PreviewV3ScopeDO" },
      { "name": "PC_CONTROL_PLANE", "class_name": "PcControlPlaneDO" },
      // The preview directory host's own scope namespace (preview-carry, scope-repoint).
      { "name": "PC_SCOPE", "class_name": "PcScopeDO" },
      // #1705 PR 2: the cross-vertical kick's coalescer, three ways, and the log its passes write.
      { "name": "KICK_TEST", "class_name": "KickTestDO" },
      { "name": "KICK_THROW", "class_name": "KickThrowDO" },
      { "name": "KICK_REAL", "class_name": "KickRealDO" },
      { "name": "KICK_LOG", "class_name": "KickLogDO" },
      { "name": "KICK_SLOW", "class_name": "KickSlowDO" },
      // #1898: a migration with a foreign key to the spine, and its twin — see test/worker.ts.
      { "name": "SPINE_PARENT_SCOPE", "class_name": "SpineParentScopeDO" },
      { "name": "OWN_PARENT_SCOPE", "class_name": "OwnParentScopeDO" },
      // #2066: migrations that reach for the migration journal — see test/worker.ts.
      { "name": "JOURNAL_FENCE_DROP_SCOPE", "class_name": "JournalFenceDropScopeDO" },
      { "name": "JOURNAL_WRITE_SCOPE", "class_name": "JournalWriteScopeDO" },
      // #1686: vertical-auth's real identity directory, for the owner claim link suite — the
      // claim link is a capability in a ScopeDO and a record in this, and both are held here.
      { "name": "AUTH", "class_name": "IdentityDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScopeDO", "ControlPlaneDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BrokenScopeDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SweeperDO", "BrokenSweeperDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ScopeSweeperDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["LiveScopeDO"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["CrmScopeDO", "BoardScopeDO"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["PreviewV1ScopeDO", "PreviewV2ScopeDO", "PreviewV3ScopeDO"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["KickTestDO", "KickThrowDO", "KickRealDO", "KickLogDO", "KickSlowDO"]
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["SpineParentScopeDO", "OwnParentScopeDO"]
    },
    {
      "tag": "v10",
      "new_sqlite_classes": [
        "SweepControlPlaneDO", "VeControlPlaneDO", "PcControlPlaneDO", "SchedControlPlaneDO",
        "SchedScopeDO", "SweepScopeDO", "PcScopeDO"
      ]
    },
    {
      "tag": "v11",
      "new_sqlite_classes": ["IdentityDO"]
    },
    {
      "tag": "v12",
      "new_sqlite_classes": ["CausedByScopeDO"]
    },
    {
      "tag": "v13",
      "new_sqlite_classes": ["JournalFenceDropScopeDO", "JournalWriteScopeDO"]
    }
  ]
}
