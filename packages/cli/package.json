{
  "name": "@substrat-run/cli",
  "version": "0.27.0",
  "description": "The substrat CLI — authenticated deploy tooling: push a vertical to the platform, manage its versions and channels",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrat-run/substrat.git",
    "directory": "packages/cli"
  },
  "homepage": "https://substrat.net/guide/deploying",
  "keywords": [
    "substrat",
    "deploy",
    "cli",
    "cloudflare",
    "workers-for-platforms"
  ],
  "type": "module",
  "bin": {
    "substrat": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@substrat-run/boundary-lint": "workspace:^",
    "@substrat-run/contracts": "workspace:^",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
