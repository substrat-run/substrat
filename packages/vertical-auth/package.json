{
  "name": "@substrat-run/vertical-auth",
  "version": "0.12.0",
  "description": "Pluggable auth for Substrat verticals — the AuthProvider contract, an OIDC provider (Supabase/Auth0/AuthHero/Keycloak), a full relying-party login flow, and a per-tenant identity Durable Object (Better Auth + sub→principal directory). Workers-targeted; the vertical worker bundles it.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrat-run/substrat.git",
    "directory": "packages/vertical-auth"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/owner-claim-link.d.ts",
      "default": "./dist/owner-claim-link.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./oidc": {
      "types": "./dist/oidc.d.ts",
      "default": "./dist/oidc.js"
    },
    "./oidc-rp-provider": {
      "types": "./dist/oidc-rp-provider.d.ts",
      "default": "./dist/oidc-rp-provider.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/oidc-rp": "workspace:^",
    "@substrat-run/psl": "workspace:^",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
