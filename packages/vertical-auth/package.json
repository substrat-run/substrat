{
  "name": "@substrat-run/vertical-auth",
  "version": "0.6.0",
  "private": true,
  "description": "Pluggable auth for Substrat verticals — the AuthProvider contract, an OIDC provider (Supabase/Auth0/AuthHero/Keycloak), and a per-tenant identity Durable Object (Better Auth + sub→principal directory). Source-exported; the vertical worker bundles it.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.ts",
    "./oidc": "./src/oidc.ts",
    "./oidc-rp-provider": "./src/oidc-rp-provider.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@substrat-run/oidc-rp": "workspace:^",
    "@substrat-run/psl": "workspace:^",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
