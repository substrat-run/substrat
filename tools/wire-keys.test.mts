// tsx --test tools/wire-keys.test.mts
//
// The wire family of the key tool (RFC wire-signing §6): the store-keys judgements over the wire's
// two issuers, with a standby key beside each key in use. Every key below is a published test
// vector (RFC 8032 §7.1 tests 1 and 2, and the envelopes' own vector files) or generated by the
// test and thrown away. None is a deployed key.
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { mkdtempSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { test } from 'node:test';
import { generateScopeStoreKeyPair, scopeStoreSignerPublicKey } from '../packages/contracts/src/scope-store-envelope.ts';
import { wireVerificationKeys } from '../packages/contracts/src/wire-signing.ts';
import { MANIFEST } from '../scripts/secrets.mjs';
import { repoRoot } from './repo-path.mjs';
import { readRepoFile, wireKeyProblems } from './store-key-inventory.mjs';
import { doctor, generate, main, rotatePlan, StoreKeysError, WIRE_FAMILY, type GenerateIo } from './store-keys.mts';

const ROOT = repoRoot(import.meta.url);
const b64u = (hex: string) => Buffer.from(hex, 'hex').toString('base64url');
const pkcs8 = (seed: string) => b64u(`302e020100300506032b657004220420${seed}`);

/** RFC 8032 test 1: the router's key in use. */
const A = { private: pkcs8('9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60'), public: '11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo', kid: 'If4x36FUomE' };
/** RFC 8032 test 2: the platform's key in use. */
const B = { private: pkcs8('4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb'), public: 'PUAXw-hDiVqStwqnTRt-vJyYLM8uxJaMwM1V8Sr0Zgw', kid: 'OfcT0KZEJT8' };
/** The store envelope's vector key: the router's standby. */
const vector = JSON.parse(readFileSync(join(ROOT, 'packages/contracts/test/vectors/scope-store-envelope.json'), 'utf8'));
const C = { private: vector.privateKeyPkcs8 as string, public: vector.publicKey as string, kid: vector.kid as string };
/** The platform's standby, generated here. */
const D = await (async () => {
  const pair = await generateScopeStoreKeyPair();
  return { private: pair.privateKey, public: pair.publicKey, kid: pair.kid };
})();

const good = {
  WIRE_ROUTER_KEY: A.private,
  WIRE_ROUTER_PUBLIC_KEYS: `${A.public},${C.public}`,
  WIRE_PLATFORM_KEY: B.private,
  WIRE_PLATFORM_PUBLIC_KEYS: `${B.public},${D.public}`,
};

const findings = async (values: Record<string, string>, level: 'error' | 'warn') =>
  (await doctor(values, [], WIRE_FAMILY)).findings.filter((f) => f.level === level).map((f) => `${f.subject} ${f.check}`);

function recorder(isTTY = false): GenerateIo & { out: string; err: string } {
  const io = { out: '', err: '', stdout: { isTTY, write: (t: string) => ((io.out += t), true) }, stderr: { write: (t: string) => ((io.err += t), true) } };
  return io;
}
const privateDir = () => mkdtempSync(join(tmpdir(), 'wire-keys-'));

// ── doctor ──────────────────────────────────────────────────────────────────────

test('doctor: each issuer with its key in use and a standby is steady, with no findings, and loads as a deployment loads it', async () => {
  const report = await doctor(good, [], WIRE_FAMILY);
  assert.deepEqual(report.findings, []);
  assert.equal(report.members['router']!.phase, 'steady');
  assert.equal(report.members['router']!.signer?.kid, A.kid);
  assert.deepEqual(report.members['router']!.listed?.map((k) => k.kid), [A.kid, C.kid]);
  assert.equal(report.members['platform']!.signer?.kid, B.kid);
  const keys = await wireVerificationKeys({ router: good.WIRE_ROUTER_PUBLIC_KEYS, platform: good.WIRE_PLATFORM_PUBLIC_KEYS });
  assert.deepEqual([...keys.router.keys()], [A.kid, C.kid]);
});

test('doctor: a list with no standby is a warning naming it, never an error; its twin with one is clean', async () => {
  const lone = { ...good, WIRE_ROUTER_PUBLIC_KEYS: A.public };
  assert.deepEqual(await findings(lone, 'error'), []);
  const warned = await findings(lone, 'warn');
  assert.ok(warned.some((f) => /^WIRE_ROUTER_PUBLIC_KEYS lists no standby key beside the one WIRE_ROUTER_KEY signs with/.test(f)), warned.join('\n'));
  assert.deepEqual(await findings(good, 'warn'), []);
});

test('doctor: a third key is a rotation in progress, by the wire-keys command', async () => {
  const warned = await findings({ ...good, WIRE_ROUTER_PUBLIC_KEYS: `${A.public},${C.public},${D.public}`, WIRE_PLATFORM_PUBLIC_KEYS: B.public }, 'warn');
  assert.ok(warned.some((f) => /lists 3 keys: a rotation is in progress \(pnpm wire-keys rotate --issuer router\)/.test(f)), warned.join('\n'));
});

test('doctor: a key in both lists is an error, so the router can never sign as the platform', async () => {
  const both = await findings({ ...good, WIRE_PLATFORM_PUBLIC_KEYS: `${B.public},${C.public}` }, 'error');
  assert.ok(both.some((f) => /WIRE_ROUTER_PUBLIC_KEYS entry 2 \(kid fX5Yi3zNBp0\) is also WIRE_PLATFORM_PUBLIC_KEYS entry 2/.test(f)), both.join('\n'));
  const signer = await findings({ ...good, WIRE_PLATFORM_PUBLIC_KEYS: `${B.public},${A.public}` }, 'error');
  assert.ok(signer.some((f) => /WIRE_ROUTER_KEY signs as kid If4x36FUomE, which WIRE_PLATFORM_PUBLIC_KEYS lists: its holder could sign platform envelopes/.test(f)), signer.join('\n'));
  // A deployment refuses the same pair when it loads it.
  await assert.rejects(wireVerificationKeys({ router: good.WIRE_ROUTER_PUBLIC_KEYS, platform: `${B.public},${C.public}` }), /both issuers/);
});

test('doctor: a signer switched before its key was listed, and one key for both issuers, are errors', async () => {
  const unlisted = await findings({ ...good, WIRE_ROUTER_KEY: D.private }, 'error');
  assert.ok(unlisted.some((f) => /WIRE_ROUTER_KEY signs as kid .*, which WIRE_ROUTER_PUBLIC_KEYS does not list: every router call is refused/.test(f)), unlisted.join('\n'));
  const shared = await findings({ ...good, WIRE_PLATFORM_KEY: A.private, WIRE_PLATFORM_PUBLIC_KEYS: B.public }, 'error');
  assert.ok(shared.some((f) => /WIRE_ROUTER_KEY is the same key as WIRE_PLATFORM_KEY: each issuer needs its own/.test(f)), shared.join('\n'));
});

test('doctor: the store family is untouched by the wire family, and neither reads the other’s names', async () => {
  const report = await doctor(good, [], WIRE_FAMILY);
  assert.deepEqual(Object.keys(report.members), ['router', 'platform']);
  const store = await doctor(good);
  assert.ok(store.findings.some((f) => f.subject === 'STORE_CALLER_PUBLIC_KEYS' && /is unset/.test(f.check)));
});

// ── rotate ──────────────────────────────────────────────────────────────────────

test('rotate: the ordered steps by wire-keys, the standby kept, and the break-glass order for a compromise', async () => {
  const plan = rotatePlan(await doctor(good, [], WIRE_FAMILY), 'router', 'test');
  for (const step of ['1. pnpm wire-keys generate --issuer router', '2. Add the new public key to WIRE_ROUTER_PUBLIC_KEYS', '4. Switch the signer', '5. Drop the old key: pnpm wire-keys rotate --issuer router --drop']) {
    assert.ok(plan.includes(step), step);
  }
  assert.match(plan, /The standby key stays listed throughout/);
  assert.match(plan, /COMPROMISED key[\s\S]*switch the signer FIRST to the standby key, which every deployment already lists[\s\S]*revoke the old WIRE_ROUTER_KEY value at the secrets\s+manager/);
  assert.match(plan, /A list reaches a deployment only when the control plane uploads it again/);
  assert.doesNotMatch(plan, /store-driver|store script/);
  assert.match(plan, /The runbook is secrets\/wire-keys\.md\./);
  assert.match(plan, /→ 1\./);
});

test('rotate --drop: refuses the signer’s key and an unlisted kid; prints the rest otherwise', async () => {
  const report = await doctor(good, [], WIRE_FAMILY);
  assert.throws(() => rotatePlan(report, 'router', 'prod', A.kid), /is the key WIRE_ROUTER_KEY signs with/);
  assert.throws(() => rotatePlan(report, 'router', 'prod', 'AAAAAAAAAAA'), /lists no key with kid AAAAAAAAAAA/);
  const out = rotatePlan(report, 'router', 'prod', C.kid);
  assert.match(out, new RegExp(`^WIRE_ROUTER_PUBLIC_KEYS=${A.public}$`, 'm'));
  assert.match(out, /--only control-plane/);
});

test('rotate: refuses a set doctor fails', async () => {
  await assert.rejects(async () => rotatePlan(await doctor({ ...good, WIRE_ROUTER_KEY: D.private }, [], WIRE_FAMILY), 'router', 'prod'), StoreKeysError);
});

// ── generate ────────────────────────────────────────────────────────────────────

test('generate --out: one 0600 WIRE_ROUTER_KEY line whose key derives the printed kid; the key itself is printed nowhere', async () => {
  const path = join(privateDir(), 'router.key');
  const io = recorder();
  const { kid, publicKey } = await generate('router', { out: path }, io, { family: WIRE_FAMILY });
  assert.equal(statSync(path).mode & 0o777, 0o600);
  const text = readFileSync(path, 'utf8');
  assert.match(text, /^WIRE_ROUTER_KEY=[A-Za-z0-9_-]+\n$/);
  const key = text.trim().slice('WIRE_ROUTER_KEY='.length);
  assert.deepEqual(await scopeStoreSignerPublicKey(key), { publicKey, kid });
  assert.match(io.err, /^issuer:\s+router \(signer: router\)$/m);
  assert.match(io.err, /A standby: list it beside the key in use and keep this file offline/);
  assert.ok(!io.err.includes(key) && !io.out.includes(key));
});

test('generate: refuses a path in this repository, and an issuer that is not one', async () => {
  await assert.rejects(generate('router', { out: join(ROOT, 'secrets/wire.key') }, recorder(), { family: WIRE_FAMILY }), /inside this repository's work tree/);
  const io = recorder();
  assert.equal(await main(['generate', '--issuer', 'caller', '--out', join(privateDir(), 'k.key')], io, WIRE_FAMILY), 1);
  assert.match(io.err, /--issuer must be router or platform/);
  // The store's flag is not the wire's.
  const store = recorder();
  assert.equal(await main(['generate', '--audience', 'router', '--stdout'], store, WIRE_FAMILY), 1);
  assert.equal(store.out, '');
});

// ── nothing private is ever echoed ──────────────────────────────────────────────

test('no wire-keys command echoes a private value, on any path, success or refusal', async () => {
  const FAKE = 'FAKEPRIVATEKEYDoNotLeakThisValue0123456789abcdefFAKE';
  const dir = privateDir();
  const files = {
    fakeEverywhere: `WIRE_ROUTER_KEY=${FAKE}\nWIRE_PLATFORM_KEY=${FAKE}x\nWIRE_ROUTER_PUBLIC_KEYS=${A.public},${FAKE}\nWIRE_PLATFORM_PUBLIC_KEYS=${A.private}\n`,
    privateInList: `WIRE_ROUTER_KEY=${A.private}\nWIRE_PLATFORM_KEY=${B.private}\nWIRE_ROUTER_PUBLIC_KEYS=${A.private},${C.public}\nWIRE_PLATFORM_PUBLIC_KEYS=${B.public},${D.public}\n`,
    good: Object.entries(good).map(([k, v]) => `${k}=${v}`).join('\n'),
  };
  const keyFile = join(dir, 'staged.key');
  writeFileSync(keyFile, `WIRE_ROUTER_KEY=${FAKE}\n`, { mode: 0o600 });
  const runs: string[][] = [];
  for (const [name, text] of Object.entries(files)) {
    const file = join(dir, `${name}.env`);
    writeFileSync(file, text, { mode: 0o600 });
    runs.push(
      ['doctor', '--file', file],
      ['doctor', '--file', file, '--key-file', keyFile],
      ['rotate', '--issuer', 'router', '--file', file],
      ['rotate', '--issuer', 'platform', '--file', file, '--key-file', keyFile],
      ['rotate', '--issuer', 'router', '--file', file, '--drop', C.kid],
    );
  }
  runs.push(['doctor', '--file', join(dir, 'missing.env')], ['nonsense', FAKE]);
  for (const argv of runs) {
    const io = recorder();
    await main(argv, io, WIRE_FAMILY);
    for (const s of [FAKE, A.private, B.private, D.private]) {
      assert.ok(!io.out.includes(s) && !io.err.includes(s), `${argv.join(' ')} echoed a private value:\n${io.out}${io.err}`);
    }
  }
});

test('the command line, end to end: pnpm wire-keys doctor and generate, exit codes and the stdout/stderr split', () => {
  const dir = privateDir();
  const env = join(dir, 'p.env');
  writeFileSync(env, Object.entries(good).map(([k, v]) => `${k}=${v}`).join('\n'), { mode: 0o600 });
  const run = (...argv: string[]) => spawnSync(process.execPath, ['--import', 'tsx', join(ROOT, 'tools/wire-keys.mts'), ...argv], { encoding: 'utf8', cwd: ROOT });
  const ok = run('doctor', '--file', env);
  assert.equal(ok.status, 0, ok.stderr);
  assert.match(ok.stdout, /● router {2}\(signer: router WIRE_ROUTER_KEY; list: WIRE_ROUTER_PUBLIC_KEYS\) {2}phase: steady/);
  assert.match(ok.stdout, /✓ ok/);
  const gen = run('generate', '--issuer', 'platform', '--stdout');
  assert.equal(gen.status, 0, gen.stderr);
  assert.match(gen.stdout, /^WIRE_PLATFORM_KEY=[A-Za-z0-9_-]+\n$/);
  assert.ok(!gen.stderr.includes(gen.stdout.trim().split('=')[1]!));
  const usage = run();
  assert.match(usage.stderr, /pnpm wire-keys generate --issuer router\|platform/);
});

// ── the inventory check in secrets-coverage ─────────────────────────────────────

test('inventory: the repository as it is passes for the wire keys', () => {
  assert.deepEqual(wireKeyProblems(MANIFEST), []);
});

test('inventory: a wire private key on a second worker, a list off the uploader, or a missing README name is refused', () => {
  const twice = structuredClone(MANIFEST) as typeof MANIFEST;
  (twice['control-plane'].secrets as Record<string, string>).WIRE_ROUTER_KEY = 'WIRE_ROUTER_KEY';
  assert.match(wireKeyProblems(twice).join('\n'), /WIRE_ROUTER_KEY is mapped on \[control-plane, router\]; it belongs on router alone/);
  const moved = structuredClone(MANIFEST) as typeof MANIFEST;
  delete (moved['control-plane'].secrets as Record<string, string>).WIRE_PLATFORM_PUBLIC_KEYS;
  (moved.router.secrets as Record<string, string>).WIRE_PLATFORM_PUBLIC_KEYS = 'WIRE_PLATFORM_PUBLIC_KEYS';
  assert.match(wireKeyProblems(moved).join('\n'), /WIRE_PLATFORM_PUBLIC_KEYS is mapped on \[router\]; it belongs on control-plane alone/);
  const read = (rel: string) => (rel === 'secrets/README.md' ? readRepoFile(rel)!.replaceAll('`WIRE_ROUTER_KEY`', 'the router key') : readRepoFile(rel));
  assert.match(wireKeyProblems(MANIFEST, read).join('\n'), /README\.md does not name `WIRE_ROUTER_KEY`/);
  const undeclared = (rel: string) => (rel === 'apps/router/src/worker.ts' ? readRepoFile(rel)!.replace(/WIRE_ROUTER_KEY\?: string;/, '') : readRepoFile(rel));
  assert.match(wireKeyProblems(MANIFEST, undeclared).join('\n'), /apps\/router\/src\/worker\.ts declares no `WIRE_ROUTER_KEY\?: string`/);
});
