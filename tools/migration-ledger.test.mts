import { spawnSync } from 'node:child_process';
import { test } from 'node:test';
import assert from 'node:assert/strict';
import { migrationDigest } from '../packages/kernel/dist/index.js';
import { appendOnlyOffences, ledgerPackages, ledgerRows, parseLedger, renderLedger, type LedgerRow } from './migration-ledger.mts';
import type { Registration } from './package-registrations.mts';

const row = (version: string, digest: string, module = 'notes'): LedgerRow => ({ module, version, digest });
const A = 'a'.repeat(64);
const B = 'b'.repeat(64);
const C = 'c'.repeat(64);

test('an unchanged base passes, and so does a migration added after it', () => {
  assert.deepEqual(appendOnlyOffences('demos/x', [row('0001', A)], [row('0001', A)]), []);
  assert.deepEqual(appendOnlyOffences('demos/x', [row('0001', A)], [row('0001', A), row('0002', B)]), []);
});

test('a migration whose SQL changed under the same version is refused', () => {
  const [offence, ...rest] = appendOnlyOffences('demos/x', [row('0001', A)], [row('0001', B)]);
  assert.match(offence!, /demos\/x: notes@0001 has other SQL than the base branch shipped/);
  assert.equal(rest.length, 0);
});

test('a migration removed is refused', () => {
  assert.match(appendOnlyOffences('demos/x', [row('0001', A), row('0002', B)], [row('0001', A)])[0]!, /notes@0002 is on the base branch and gone here/);
});

test('a renamed version is refused even though the SQL is identical', () => {
  const offences = appendOnlyOffences('demos/x', [row('0001', A)], [row('0001_init', A)]);
  assert.equal(offences.length, 1);
  assert.match(offences[0]!, /notes@0001 is on the base branch and gone here \(removed, or its version renamed\)/);
});

test('the same version under another module is a different migration', () => {
  assert.equal(appendOnlyOffences('demos/x', [row('0001', A, 'notes')], [row('0001', A, 'tasks')]).length, 1);
});

test('reordering what the base shipped is not an edit', () => {
  assert.deepEqual(appendOnlyOffences('demos/x', [row('0001', A), row('0002', B)], [row('0002', B), row('0001', A), row('0003', C)]), []);
});

test('a rendered ledger parses back to its rows', () => {
  const rows = [row('0001', A), row('0002_add_due', B, '@substrat-run/demo-x')];
  const text = renderLedger('demos/x', 'src/provision.ts', rows);
  assert.match(text, /^<!-- GENERATED by tools\/migration-ledger\.mts from src\/provision\.ts/);
  assert.deepEqual(parseLedger(text), rows);
});

test('the digest is the one a scope records: the kernel\'s own, over the SQL text', async () => {
  const sql = 'CREATE TABLE notes (id TEXT PRIMARY KEY);';
  const registration = { manifest: { id: 'notes' }, migrations: [{ version: '0001', sql }] } as unknown as Registration;
  assert.deepEqual(await ledgerRows([registration]), [row('0001', await migrationDigest(sql))]);
});

test('whitespace in the SQL is part of what a scope hashes, so it is an edit too', async () => {
  const before = await migrationDigest('CREATE TABLE notes (id TEXT);');
  const after = await migrationDigest('CREATE TABLE notes (id  TEXT);');
  assert.equal(appendOnlyOffences('demos/x', [row('0001', before)], [row('0001', after)]).length, 1);
});

test('a base the checkout does not hold is exit 2, in the ledger\'s own terms', () => {
  const run = spawnSync('npx', ['tsx', 'tools/migration-ledger.mts', '--base', 'refs/heads/no-such-base-2365'], { encoding: 'utf8' });
  assert.equal(run.status, 2);
  assert.match(run.stderr, /no migration the base shipped would be compared/);
  assert.doesNotMatch(run.stderr, /export/);
});

test('every tracked ledger is a candidate, so one no package emits any more is caught as orphaned', () => {
  assert.deepEqual(ledgerPackages('demos/todo/MIGRATIONS.md\nengines/x/MIGRATIONS.md\nMIGRATIONS.md\ndemos/todo/docs/MIGRATIONS.md\n'), ['demos/todo', 'engines/x']);
});
