/**
 * A project's migrations, generated from its model — what `demos/todo`'s own
 * `tools/emit-migrations.mts` does for todo, for a project the studio builds.
 *
 *     pnpm exec tsx tools/migrations-emit.mts --root <project> [--check]
 *
 * `journal.json` is the record: `planMigration` reconstructs what it has applied,
 * diffs it against the entities `spec/model.ts` declares, and appends exactly one
 * entry when they differ, never rewriting one. `src/migrations.generated.ts` is the
 * shape the kernel registers, re-rendered from the journal on every run. The studio
 * runs this after every turn, as it runs `tools/model-diff.mts --root`, so a build
 * never writes DDL for the model's tables and the two cannot disagree.
 *
 * Exit 0: written, or current. 1: under `--check`, the journal is behind the model
 * or the module has drifted from the journal. 2: the model will not load, has no
 * entities, or the plan is refused — a change that needs a decision, not a diff.
 */
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { join, resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import { parseJournal, planMigration, type Journal } from '../packages/model-emit/src/index.js';

const args = process.argv.slice(2);
const check = args.includes('--check');
const rootAt = args.indexOf('--root');
const root = rootAt >= 0 ? args[rootAt + 1] : undefined;

function cannot(message: string): never {
  process.stderr.write(`migrations-emit: ${message}\n`);
  process.exit(2);
}

if (!root) cannot('pass --root <project>');
const src = join(root, 'spec/model.ts');
const journalPath = join(root, 'journal.json');
const modulePath = join(root, 'src/migrations.generated.ts');
if (!existsSync(src)) cannot(`${src} does not exist`);

let mod: Record<string, unknown>;
try {
  mod = (await import(pathToFileURL(resolve(src)).href)) as Record<string, unknown>;
} catch (e) {
  cannot(`${src} could not be imported — ${e instanceof Error ? e.message : String(e)}`);
}

/**
 * The `defineEntities(...)` result, found by its shape: every value a `{ table, fields }`
 * whose fields are a schema. A build names the export as it likes (`entities`,
 * `todoEntities`), and the emitted model (`{ entities: … }`) is one level deeper, so it
 * does not match.
 */
const isEntities = (value: unknown): value is Record<string, { table: string; fields: unknown }> => {
  if (!value || typeof value !== 'object') return false;
  const rows = Object.values(value);
  return (
    rows.length > 0 &&
    rows.every((e) => !!e && typeof e === 'object' && typeof (e as { table?: unknown }).table === 'string' && !!(e as { fields?: { shape?: unknown } }).fields?.shape)
  );
};
const found = Object.values(mod).filter(isEntities);
const unique = [...new Set(found)];
if (unique.length !== 1) cannot(`${src} exports ${unique.length} entity declarations, expected exactly 1 (a defineEntities(...) result)`);
const entities = unique[0]!;

let journal: Journal = { entries: [] };
if (existsSync(journalPath)) {
  try {
    journal = parseJournal(JSON.parse(readFileSync(journalPath, 'utf8')));
  } catch (e) {
    cannot(`${journalPath} is not a journal — ${e instanceof Error ? e.message : String(e)}`);
  }
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const plan = planMigration(entities as any, journal);
if (plan.kind === 'refused') {
  cannot(`the change to spec/model.ts is refused — this is a decision, not a diff:\n${plan.reasons.map((r) => `  • ${r}`).join('\n')}`);
}

const next: Journal = plan.kind === 'append' ? { entries: [...journal.entries, plan.entry] } : journal;

/** The SQL as one template literal holding exactly the journal's text: nothing it contains can end it or interpolate. */
const literal = (sql: string): string => `\`${sql.replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$\{/g, '\\${')}\``;

const module = `/**
 * GENERATED by tools/migrations-emit.mts from journal.json — do not edit by hand.
 *
 * journal.json is the record; this is the shape the kernel registers. The studio
 * appends a migration to the journal whenever spec/model.ts changes, and never
 * rewrites one, so a change to a table is a change to the model.
 */
import type { SqlMigration } from '@substrat-run/kernel';

export const migrations: SqlMigration[] = [
${next.entries
  .map(
    (e) => `  {
    // ${e.slug}
    version: '${e.version}',
    sql: ${literal(e.sql)},
  },`,
  )
  .join('\n')}
];
`;

if (check) {
  if (plan.kind === 'append') {
    process.stderr.write(`migrations-emit: ${journalPath} is behind spec/model.ts — ${plan.entry.slug} is unapplied; re-run without --check\n`);
    process.exit(1);
  }
  const onDisk = existsSync(modulePath) ? readFileSync(modulePath, 'utf8') : null;
  if (onDisk !== module) {
    process.stderr.write(`migrations-emit: ${modulePath} is stale — re-run without --check\n`);
    process.exit(1);
  }
  process.exit(0);
}

if (plan.kind === 'append') writeFileSync(journalPath, `${JSON.stringify(next, null, 2)}\n`);
const current = existsSync(modulePath) ? readFileSync(modulePath, 'utf8') : null;
if (current !== module) writeFileSync(modulePath, module);
process.stdout.write(plan.kind === 'append' ? `migrations-emit: appended ${plan.entry.version}-${plan.entry.slug}\n` : 'migrations-emit: current\n');
