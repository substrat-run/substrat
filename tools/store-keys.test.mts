// tsx --test tools/store-keys.test.mts
//
// Every key below is a published test vector (RFC 8032 §7.1 tests 1 and 2, and the envelope's
// own vector file) or generated by the test and thrown away. None is a deployed key.
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import * as fs from 'node:fs';
import { chmodSync, existsSync, fstatSync, mkdirSync, mkdtempSync, readFileSync, statSync, symlinkSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { test } from 'node:test';
import { scopeStoreSignerPublicKey } from '../packages/contracts/src/scope-store-envelope.ts';
import { MANIFEST } from '../scripts/secrets.mjs';
import { repoRoot } from './repo-path.mjs';
import { readRepoFile, storeKeyProblems } from './store-key-inventory.mjs';
import {
  assertPrivateOutPath,
  doctor,
  generate,
  main,
  rotatePlan,
  StoreKeysError,
  writePrivateFile,
  type GenerateIo,
} from './store-keys.mts';

const ROOT = repoRoot(import.meta.url);

const b64u = (hex: string) => Buffer.from(hex, 'hex').toString('base64url');
const pkcs8 = (seed: string) => b64u(`302e020100300506032b657004220420${seed}`);

/** RFC 8032 test 1: secret, public key, and the kid derived from it (fixed, not recomputed). */
const A = {
  private: pkcs8('9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60'),
  public: '11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo',
  kid: 'If4x36FUomE',
};
/** RFC 8032 test 2. */
const B = {
  private: pkcs8('4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb'),
  public: 'PUAXw-hDiVqStwqnTRt-vJyYLM8uxJaMwM1V8Sr0Zgw',
  kid: 'OfcT0KZEJT8',
};
/** The envelope module's own vector. */
const vector = JSON.parse(readFileSync(join(ROOT, 'packages/contracts/test/vectors/scope-store-envelope.json'), 'utf8'));
const C = { private: vector.privateKeyPkcs8 as string, public: vector.publicKey as string, kid: vector.kid as string };

/** The same 32 bytes as `key` in another spelling: a 43-character key has 2 unused bits. */
const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
const alias = (key: string) => key.slice(0, -1) + ALPHABET[ALPHABET.indexOf(key.at(-1)!) ^ 1];
/** The identity point: small order. */
const IDENTITY = b64u(`01${'00'.repeat(31)}`);

const good = {
  STORE_CALLER_KEY: A.private,
  STORE_CALLER_PUBLIC_KEYS: A.public,
  STORE_PLATFORM_KEY: B.private,
  STORE_PLATFORM_PUBLIC_KEYS: B.public,
};

const errors = async (values: Record<string, string>, staged: { label: string; text: string }[] = []) =>
  (await doctor(values, staged)).findings.filter((f) => f.level === 'error').map((f) => `${f.subject} ${f.check}`);

/** An io that records everything written. */
function recorder(isTTY = false): GenerateIo & { out: string; err: string } {
  const io = {
    out: '',
    err: '',
    stdout: { isTTY, write: (t: string) => ((io.out += t), true) },
    stderr: { write: (t: string) => ((io.err += t), true) },
  };
  return io;
}

/** A fresh directory only this user can read, outside every work tree. */
const privateDir = () => mkdtempSync(join(tmpdir(), 'store-keys-'));

// ── the fixed vectors ───────────────────────────────────────────────────────────

test('the RFC 8032 vectors derive the fixed public keys and kids through the signer', async () => {
  assert.deepEqual(await scopeStoreSignerPublicKey(A.private), { publicKey: A.public, kid: A.kid });
  assert.deepEqual(await scopeStoreSignerPublicKey(B.private), { publicKey: B.public, kid: B.kid });
});

// ── doctor ──────────────────────────────────────────────────────────────────────

test('doctor: a good set has no findings, is steady, and marks each signer', async () => {
  const report = await doctor(good);
  assert.deepEqual(report.findings, []);
  assert.equal(report.audiences.caller.phase, 'steady');
  assert.equal(report.audiences.caller.signer?.kid, A.kid);
  assert.deepEqual(report.audiences.caller.listed?.map((k) => k.kid), [A.kid]);
  assert.equal(report.audiences.platform.signer?.kid, B.kid);
});

test('doctor: a missing list and a missing private key are errors', async () => {
  const { STORE_CALLER_PUBLIC_KEYS: _l, STORE_PLATFORM_KEY: _k, ...rest } = good;
  const found = await errors(rest);
  assert.ok(found.some((f) => f.startsWith('STORE_CALLER_PUBLIC_KEYS is unset')), found.join('\n'));
  assert.ok(found.some((f) => f.startsWith('STORE_PLATFORM_KEY is unset')), found.join('\n'));
});

test('doctor: bad list entries are named by position', async () => {
  const cases: [string, RegExp][] = [
    [`${A.public},${IDENTITY}`, /entry 2 is a small-order point/],
    [`${A.public},${alias(C.public)}`, /entry 2 is not canonical/],
    [`${A.public},${A.public}`, /entry 2 is entry 1 again/],
    [`${A.public},abc`, /entry 2 is not 32 bytes/],
    [`${A.public},`, /entry 2 is empty/],
  ];
  for (const [list, expected] of cases) {
    const found = await errors({ ...good, STORE_CALLER_PUBLIC_KEYS: list });
    assert.ok(found.some((f) => expected.test(f)), `${expected}: ${found.join('\n')}`);
  }
});

test('doctor: an alias of a listed key is caught as not canonical, and as no second key', async () => {
  const report = await doctor({ ...good, STORE_CALLER_PUBLIC_KEYS: `${A.public},${alias(A.public)}` });
  assert.ok(report.findings.some((f) => /entry 2 is not canonical/.test(f.check)));
  assert.equal(report.audiences.caller.listed?.length, 1);
});

test('doctor: a key in both lists is an error, compared as bytes', async () => {
  const found = await errors({ ...good, STORE_PLATFORM_PUBLIC_KEYS: `${B.public},${A.public}` });
  assert.ok(found.some((f) => /STORE_CALLER_PUBLIC_KEYS entry 1 \(kid If4x36FUomE\) is also STORE_PLATFORM_PUBLIC_KEYS entry 2/.test(f)), found.join('\n'));
  // The caller signer is in the platform list too, and says so.
  assert.ok(found.some((f) => /STORE_CALLER_KEY signs as kid If4x36FUomE, which STORE_PLATFORM_PUBLIC_KEYS lists/.test(f)), found.join('\n'));
});

test('doctor: a signer whose key is not listed is an error (switched before listing)', async () => {
  const found = await errors({ ...good, STORE_CALLER_KEY: C.private });
  assert.ok(found.some((f) => /STORE_CALLER_KEY signs as kid fX5Yi3zNBp0, which STORE_CALLER_PUBLIC_KEYS does not list/.test(f)), found.join('\n'));
});

test('doctor: one private key for both audiences is an error', async () => {
  const found = await errors({ ...good, STORE_PLATFORM_KEY: A.private, STORE_PLATFORM_PUBLIC_KEYS: B.public });
  assert.ok(found.some((f) => /STORE_CALLER_KEY is the same key as STORE_PLATFORM_KEY/.test(f)), found.join('\n'));
});

test('doctor: an unusable private key is an error naming the check', async () => {
  for (const [value, expected] of [
    ['not*base64', /STORE_CALLER_KEY is not base64url/],
    [A.public, /STORE_CALLER_KEY is not an Ed25519 PKCS8 key/],
  ] as const) {
    const found = await errors({ ...good, STORE_CALLER_KEY: value });
    assert.ok(found.some((f) => expected.test(f)), found.join('\n'));
  }
});

test('doctor: the rotation phase follows the staged key', async () => {
  const staged = [{ label: 'new.key', text: `STORE_CALLER_KEY=${C.private}\n` }];
  const two = { ...good, STORE_CALLER_PUBLIC_KEYS: `${A.public},${C.public}` };
  assert.equal((await doctor(two)).audiences.caller.phase, 'two-listed');
  assert.equal((await doctor(two, staged)).audiences.caller.phase, 'listed');
  assert.equal((await doctor({ ...two, STORE_CALLER_KEY: C.private }, staged)).audiences.caller.phase, 'switched');
  // Staged but not listed yet: a warning, not an error.
  const report = await doctor(good, staged);
  assert.ok(report.findings.some((f) => f.level === 'warn' && /is not in STORE_CALLER_PUBLIC_KEYS yet/.test(f.check)));
  assert.equal(report.findings.filter((f) => f.level === 'error').length, 0);
});

test('doctor: a staged key listed for the other audience, or equal to its signer, is an error', async () => {
  const listedThere = await errors({ ...good, STORE_PLATFORM_PUBLIC_KEYS: `${B.public},${C.public}` }, [
    { label: 'new.key', text: `STORE_CALLER_KEY=${C.private}` },
  ]);
  assert.ok(listedThere.some((f) => /new.key \(kid fX5Yi3zNBp0, caller\) is listed in STORE_PLATFORM_PUBLIC_KEYS/.test(f)), listedThere.join('\n'));
  const theirSigner = await errors(good, [{ label: 'new.key', text: `STORE_CALLER_KEY=${B.private}` }]);
  assert.ok(theirSigner.some((f) => /new.key is the same key as STORE_PLATFORM_KEY/.test(f)), theirSigner.join('\n'));
  const notAKeyFile = await errors(good, [{ label: 'x.key', text: `SOMETHING=${C.private}` }]);
  assert.ok(notAKeyFile.some((f) => /x.key is not one STORE_CALLER_KEY= or STORE_PLATFORM_KEY= line/.test(f)));
});

// ── rotate ──────────────────────────────────────────────────────────────────────

test('rotate: prints the ordered steps, the compromise order and the #2309 limit', async () => {
  const plan = rotatePlan(await doctor(good), 'caller', 'prod');
  for (const step of ['1. pnpm store-keys generate', '2. Add the new public key', '4. Switch the signer', '5. Drop the old key']) {
    assert.ok(plan.includes(step), step);
  }
  assert.ok(plan.indexOf('2. Add') < plan.indexOf('4. Switch') && plan.indexOf('4. Switch') < plan.indexOf('5. Drop'));
  assert.match(plan, /COMPROMISED key[\s\S]*switch the signer FIRST[\s\S]*revoke the old\s+STORE_CALLER_KEY value at the secrets manager/);
  assert.match(plan, /#2309/);
  assert.match(plan, /→ 1\./);
});

test('rotate: refuses a set doctor fails, the other audience included', async () => {
  await assert.rejects(async () => rotatePlan(await doctor({ ...good, STORE_CALLER_KEY: C.private }), 'caller', 'prod'), StoreKeysError);
  await assert.rejects(async () => rotatePlan(await doctor({ ...good, STORE_PLATFORM_PUBLIC_KEYS: `${B.public},${A.public}` }), 'platform', 'prod'), /not safe to rotate/);
});

test('rotate --drop: refuses the signer\'s key and an unlisted kid; prints the rest otherwise', async () => {
  const switched = await doctor({ ...good, STORE_CALLER_KEY: C.private, STORE_CALLER_PUBLIC_KEYS: `${A.public},${C.public}` });
  assert.throws(() => rotatePlan(switched, 'caller', 'prod', C.kid), /is the key STORE_CALLER_KEY signs with/);
  assert.throws(() => rotatePlan(switched, 'caller', 'prod', 'AAAAAAAAAAA'), /lists no key with kid AAAAAAAAAAA/);
  const out = rotatePlan(switched, 'caller', 'prod', A.kid);
  assert.match(out, new RegExp(`^STORE_CALLER_PUBLIC_KEYS=${C.public}$`, 'm'));
  assert.ok(!out.includes(A.public));
});

test('rotate --drop: refuses when the signer is unset', async () => {
  const { STORE_CALLER_KEY: _k, ...rest } = good;
  // doctor reports the unset key as an error, which already blocks.
  await assert.rejects(async () => rotatePlan(await doctor({ ...rest, STORE_CALLER_PUBLIC_KEYS: `${A.public},${C.public}` }), 'caller', 'prod', A.kid), StoreKeysError);
});

// ── generate ────────────────────────────────────────────────────────────────────

test('generate --out: writes one 0600 line whose key derives the printed kid', async () => {
  const path = join(privateDir(), 'caller.key');
  const io = recorder();
  const { kid, publicKey } = await generate('caller', { out: path }, io);
  assert.equal(statSync(path).mode & 0o777, 0o600);
  const text = readFileSync(path, 'utf8');
  assert.match(text, /^STORE_CALLER_KEY=[A-Za-z0-9_-]+\n$/);
  const key = text.trim().slice('STORE_CALLER_KEY='.length);
  assert.deepEqual(await scopeStoreSignerPublicKey(key), { publicKey, kid });
  assert.ok(io.err.includes(kid) && io.err.includes(publicKey));
  assert.ok(!io.err.includes(key) && !io.out.includes(key));
});

test('generate --out: refuses an existing file, and never overwrites it', async () => {
  const path = join(privateDir(), 'taken.key');
  writeFileSync(path, 'keep me', { mode: 0o600 });
  await assert.rejects(generate('caller', { out: path }, recorder()), /already exists/);
  assert.equal(readFileSync(path, 'utf8'), 'keep me');
});

test('generate --out: refuses a path in this repository, through a symlink too', async () => {
  assert.throws(() => assertPrivateOutPath(join(ROOT, 'secrets/new.key')), /inside this repository's work tree/);
  const dir = privateDir();
  symlinkSync(join(ROOT, 'secrets'), join(dir, 'link'));
  assert.throws(() => assertPrivateOutPath(join(dir, 'link', 'new.key')), /inside this repository's work tree/);
  assert.equal(existsSync(join(ROOT, 'secrets/new.key')), false);
});

test('generate --out: refuses a path in any other git work tree', () => {
  const repo = privateDir();
  assert.equal(spawnSync('git', ['init', '-q', repo]).status, 0);
  mkdirSync(join(repo, 'sub'), { mode: 0o700 });
  assert.throws(() => assertPrivateOutPath(join(repo, 'sub', 'k.key')), /inside the git work tree/);
});

test('generate --out: refuses a directory other users can read or write; the twin passes', () => {
  const dir = privateDir();
  chmodSync(dir, 0o755);
  assert.throws(() => assertPrivateOutPath(join(dir, 'k.key')), /open to other users/);
  chmodSync(dir, 0o750);
  assert.equal(assertPrivateOutPath(join(dir, 'k.key')).endsWith('k.key'), true);
});

test('generate --out: refuses a missing directory', () => {
  assert.throws(() => assertPrivateOutPath(join(privateDir(), 'nope', 'k.key')), /does not exist/);
});

test('writePrivateFile: a file that comes out readable by others is removed and refused', () => {
  const path = join(privateDir(), 'k.key');
  let unlinked = false;
  // Real files, with fstat reporting the mode a permissive filesystem could hand back.
  const widened = {
    openSync: fs.openSync,
    closeSync: fs.closeSync,
    fstatSync: (fd: number) => Object.assign(fstatSync(fd), { mode: 0o100644 }),
    writeSync: () => assert.fail('wrote a key into a readable file'),
    unlinkSync: (p: string) => {
      unlinked = true;
      fs.unlinkSync(p);
    },
  };
  assert.throws(() => writePrivateFile(path, 'STORE_CALLER_KEY=x', widened as never), /readable by others/);
  assert.ok(unlinked);
  assert.equal(existsSync(path), false);
});

test('generate --stdout: refuses a terminal unless told, warns, and prints only the key line', async () => {
  await assert.rejects(generate('platform', { toTerminal: false }, recorder(true)), /stdout is a terminal/);
  const tty = recorder(true);
  await generate('platform', { toTerminal: true }, tty);
  assert.match(tty.out, /^STORE_PLATFORM_KEY=[A-Za-z0-9_-]+\n$/);
  const piped = recorder(false);
  const { kid } = await generate('platform', { toTerminal: false }, piped);
  assert.match(piped.out, /^STORE_PLATFORM_KEY=[A-Za-z0-9_-]+\n$/);
  const key = piped.out.trim().split('=')[1]!;
  assert.match(piped.err, /scrollback/);
  assert.ok(piped.err.includes(kid) && !piped.err.includes(key));
});

test('generate: needs exactly one of --out and --stdout', async () => {
  for (const argv of [['generate', '--audience', 'caller'], ['generate', '--audience', 'caller', '--stdout', '--out', '/x']]) {
    const io = recorder();
    assert.equal(await main(argv, io), 1);
    assert.match(io.err, /exactly one of --out <path> or --stdout/);
    assert.equal(io.out, '');
  }
});

// ── nothing private is ever echoed ──────────────────────────────────────────────

test('no command echoes a private value, on any path, success or refusal', async () => {
  // A recognisable fake (base64url characters, the wrong length) and a real key in wrong places.
  const FAKE = 'FAKEPRIVATEKEYDoNotLeakThisValue0123456789abcdefFAKE';
  const dir = privateDir();
  const files = {
    fakeEverywhere: `STORE_CALLER_KEY=${FAKE}\nSTORE_PLATFORM_KEY=${FAKE}x\nSTORE_CALLER_PUBLIC_KEYS=${A.public},${FAKE}\nSTORE_PLATFORM_PUBLIC_KEYS=${A.private}\n`,
    privateInList: `STORE_CALLER_KEY=${A.private}\nSTORE_PLATFORM_KEY=${B.private}\nSTORE_CALLER_PUBLIC_KEYS=${A.private}\nSTORE_PLATFORM_PUBLIC_KEYS=${B.public}\n`,
    good: Object.entries(good).map(([k, v]) => `${k}=${v}`).join('\n'),
  };
  const keyFile = join(dir, 'staged.key');
  writeFileSync(keyFile, `STORE_CALLER_KEY=${FAKE}\n`, { mode: 0o600 });
  const runs: string[][] = [];
  for (const [name, text] of Object.entries(files)) {
    const file = join(dir, `${name}.env`);
    writeFileSync(file, text, { mode: 0o600 });
    runs.push(
      ['doctor', '--file', file],
      ['doctor', '--file', file, '--key-file', keyFile],
      ['rotate', '--audience', 'caller', '--file', file],
      ['rotate', '--audience', 'platform', '--file', file, '--key-file', keyFile],
      ['rotate', '--audience', 'caller', '--file', file, '--drop', A.kid],
    );
  }
  runs.push(['doctor', '--file', join(dir, 'missing.env')], ['doctor', '--file', dir], ['nonsense', FAKE]);
  const secrets = [FAKE, A.private, B.private];
  let refused = 0;
  for (const argv of runs) {
    const io = recorder();
    if ((await main(argv, io)) !== 0) refused++;
    for (const s of secrets) {
      // A key file's path and a --drop kid are the operator's own text; the private values are not.
      assert.ok(!io.out.includes(s) && !io.err.includes(s), `${argv.join(' ')} echoed a private value:\n${io.out}${io.err}`);
    }
  }
  assert.ok(refused >= runs.length - 2, 'the fixture sets are meant to fail');
});

test('the command line, end to end: exit codes and the stdout/stderr split', () => {
  const dir = privateDir();
  const env = join(dir, 'p.env');
  writeFileSync(env, Object.entries(good).map(([k, v]) => `${k}=${v}`).join('\n'), { mode: 0o600 });
  const run = (...argv: string[]) => spawnSync(process.execPath, ['--import', 'tsx', join(ROOT, 'tools/store-keys.mts'), ...argv], { encoding: 'utf8', cwd: ROOT });
  const ok = run('doctor', '--file', env);
  assert.equal(ok.status, 0, ok.stderr);
  assert.match(ok.stdout, /✓ ok/);
  const bad = run('doctor', '--file', join(dir, 'nope.env'));
  assert.equal(bad.status, 1);
  assert.match(bad.stderr, /cannot read the env file/);
  const gen = run('generate', '--audience', 'caller', '--stdout');
  assert.equal(gen.status, 0, gen.stderr);
  assert.match(gen.stdout, /^STORE_CALLER_KEY=[A-Za-z0-9_-]+\n$/);
  assert.ok(!gen.stderr.includes(gen.stdout.trim().split('=')[1]!));
});

// ── the inventory check in secrets-coverage ─────────────────────────────────────

const realRead = readRepoFile;
const coverage = (manifest = MANIFEST, read: (rel: string) => string | undefined = realRead) => storeKeyProblems(manifest, read);
const clone = () => structuredClone(MANIFEST) as typeof MANIFEST;

test('inventory: the repository as it is passes', () => {
  assert.deepEqual(coverage(), []);
});

test('inventory: a private key on a second worker, or missing from its signer, is refused', () => {
  const twice = clone();
  (twice.dashboard.secrets as Record<string, string>).STORE_CALLER_KEY = 'STORE_CALLER_KEY';
  assert.match(coverage(twice).join('\n'), /STORE_CALLER_KEY is mapped on \[dashboard, router\]; it belongs on router alone/);
  const gone = clone();
  delete (gone['control-plane'].secrets as Record<string, string>).STORE_PLATFORM_KEY;
  assert.match(coverage(gone).join('\n'), /STORE_PLATFORM_KEY is mapped on \[\]; it belongs on control-plane alone/);
});

test('inventory: a renamed mapping and an undeclared Env field are refused', () => {
  const renamed = clone();
  const secrets = renamed.router.secrets as Record<string, string>;
  delete secrets.STORE_CALLER_KEY;
  secrets.CALLER_KEY = 'STORE_CALLER_KEY';
  assert.match(coverage(renamed).join('\n'), /router maps STORE_CALLER_KEY under another name/);
  const read = (rel: string) => (rel === 'apps/router/src/worker.ts' ? realRead(rel)!.replace(/STORE_CALLER_KEY\?: string;/, '') : realRead(rel));
  assert.match(coverage(MANIFEST, read).join('\n'), /apps\/router\/src\/worker\.ts declares no `STORE_CALLER_KEY\?: string`/);
});

test('inventory: a template or README missing a name is refused', () => {
  const read = (rel: string) =>
    rel === 'secrets/platform.dev.env.example'
      ? realRead(rel)!.replace(/^STORE_PLATFORM_PUBLIC_KEYS=.*$/m, '')
      : rel === 'secrets/README.md'
        ? realRead(rel)!.replaceAll('`STORE_CALLER_KEY`', 'the caller key')
        : realRead(rel);
  const found = coverage(MANIFEST, read).join('\n');
  assert.match(found, /platform\.dev\.env\.example has no STORE_PLATFORM_PUBLIC_KEYS= line/);
  assert.match(found, /README\.md does not name `STORE_CALLER_KEY`/);
});
