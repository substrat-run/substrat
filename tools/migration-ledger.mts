/**
 * The migration ledger — a shipped migration is never edited (#2365, S4 of the review checklist).
 *
 * A scope records the sha256 of every migration it applies, and on its next migration pass it
 * refuses to go on if a registered migration's SQL no longer matches what it ran
 * (`migrationDivergence`, #2066): the scope fails closed, and the fix is a rebuild or a restore.
 * That is the right answer for data and the wrong place to learn it, because it is learned in
 * the first populated scope that meets the edited code. Nothing in a pull request refused the
 * edit: `lint:migrations --check` holds a generated module to its journal, and
 * `lint:migration-fence` judges what a migration loses, but neither compares a migration with
 * the one the base branch shipped under the same version.
 *
 * So each package that authors migrations carries `MIGRATIONS.md`: every migration its OWN
 * modules author, in the order a scope applies them, with the digest a scope's journal records
 * for it — computed by the kernel's own `migrationSteps`, never by a copy here. Modules an
 * engine ships are in the engine's ledger only, so composing an engine does not copy its rows
 * into every vertical. The scaffold template has none: a scaffolded project owns its copy, and
 * no scope of ours runs the template's migrations.
 *
 *   pnpm lint:migration-ledger                 re-emit every ledger
 *   pnpm lint:migration-ledger --check         CI: exit 1 if a ledger is stale, missing or orphaned
 *   pnpm lint:migration-ledger --base <ref>    CI: exit 1 if a migration the base's ledger lists
 *                                              is gone or has other SQL now
 *
 * `--base` compares the base's checked-in ledgers with the ledgers this checkout's CODE emits
 * (not its files), so editing a ledger to match an edited migration does not get past it.
 * Adding a migration is fine; changing one, removing one or renaming its version is refused
 * (a rename is a removal and an addition: a scope that applied the old version still has it in
 * its journal and runs the new one again). A package whose registrations are gone entirely —
 * a demo deleted — is printed and not refused: nothing ships its migrations any more. There is
 * no opt-out, because the run-time check it front-runs has none.
 *
 * Exit codes follow boundary-lint's: 0 = clean, 1 = refused, 2 = cannot run (a base the
 * checkout does not hold, a registration that does not load). Needs the build.
 */
import { execFileSync } from 'node:child_process';
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
import { migrationSteps } from '../packages/kernel/dist/index.js';
import { registrations, type Registration } from './migration-registrations.mts';

export const LEDGER = 'MIGRATIONS.md';
const TOOL = 'tools/migration-ledger.mts';

export interface LedgerRow {
  readonly module: string;
  readonly version: string;
  readonly digest: string;
}

/** The authored migrations of `modules`, in apply order, with the digest a scope records. */
export async function ledgerRows(modules: readonly Registration[]): Promise<LedgerRow[]> {
  const rows: LedgerRow[] = [];
  for (const registration of modules) {
    for (const step of await migrationSteps(registration)) {
      if (step.authored) rows.push({ module: registration.manifest.id, version: step.migration.version, digest: step.digest });
    }
  }
  return rows;
}

export function renderLedger(label: string, entry: string, rows: readonly LedgerRow[]): string {
  return [
    `<!-- GENERATED by ${TOOL} from ${entry} — do not edit by hand.`,
    '     Regenerate: pnpm lint:migration-ledger',
    '     Append-only: CI refuses a row that changed or disappeared against the base branch. -->',
    '',
    `# Migration ledger — ${label}`,
    '',
    'Every migration this package\'s own modules author, in the order a scope applies them, with',
    'the sha256 of its SQL that a scope records when it applies it. A scope whose recorded digest',
    'no longer matches the registered SQL fails closed, so a row here is never changed or removed',
    'once it is on the base branch: add a new migration instead.',
    '',
    '| Module | Version | sha256 |',
    '|---|---|---|',
    ...rows.map((r) => `| ${r.module} | ${r.version} | \`${r.digest}\` |`),
    '',
  ].join('\n');
}

export function parseLedger(text: string): LedgerRow[] {
  return [...text.matchAll(/^\| (\S+) \| (\S+) \| `([0-9a-f]{64})` \|$/gm)].map(([, module, version, digest]) => ({
    module: module!,
    version: version!,
    digest: digest!,
  }));
}

/** What a head refuses against its base: a base row now missing, or now holding other SQL. */
export function appendOnlyOffences(label: string, base: readonly LedgerRow[], head: readonly LedgerRow[]): string[] {
  const now = new Map(head.map((r) => [`${r.module}@${r.version}`, r.digest]));
  return base.flatMap((r) => {
    const key = `${r.module}@${r.version}`;
    const digest = now.get(key);
    if (digest === undefined) {
      return [`${label}: ${key} is on the base branch and gone here (removed, or its version renamed)`];
    }
    if (digest !== r.digest) return [`${label}: ${key} has other SQL than the base branch shipped (sha256 ${r.digest} → ${digest})`];
    return [];
  });
}

const git = (args: string[]): string => execFileSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });

function cannot(message: string): never {
  console.error(`migration-ledger: ${message}`);
  process.exit(2);
}

async function main(): Promise<void> {
  const argv = process.argv.slice(2);
  const check = argv.includes('--check');
  const baseAt = argv.indexOf('--base');
  const base = baseAt === -1 ? undefined : argv[baseAt + 1];
  if (baseAt !== -1 && (!base || base.startsWith('--'))) cannot('--base needs a ref');

  const packages = (await registrations('migration-ledger', { template: false }));
  // A module an engine ships is in that engine's ledger, and only there.
  const engineModules = new Set(packages.filter((p) => p.label.startsWith('engines/')).flatMap((p) => p.modules.map((m) => m.manifest.id)));
  const emitted = new Map<string, { rows: LedgerRow[]; text: string }>();
  for (const { label, entry, modules } of packages) {
    const own = label.startsWith('engines/') ? modules : modules.filter((m) => !engineModules.has(m.manifest.id));
    const rows = await ledgerRows(own);
    if (rows.length > 0) emitted.set(label, { rows, text: renderLedger(label, entry, rows) });
  }

  if (base !== undefined) {
    try {
      git(['rev-parse', '--verify', '--quiet', `${base}^{commit}`]);
    } catch {
      cannot(`the base ${base} is not in this checkout; fetch it first. Refusing to judge against nothing.`);
    }
    const ledgers = git(['ls-tree', '-r', '--name-only', base, '--', 'demos', 'apps', 'engines'])
      .split('\n')
      .filter((p) => p.endsWith(`/${LEDGER}`) && p.split('/').length === 3);
    const offences: string[] = [];
    for (const path of ledgers) {
      const label = path.slice(0, -(LEDGER.length + 1));
      const before = parseLedger(git(['show', `${base}:${path}`]));
      const headPackage = packages.find((p) => p.label === label);
      if (!headPackage) {
        console.log(`migration-ledger: ${label} ships no registrations here any more; its ${before.length} migration(s) are not judged.`);
        continue;
      }
      offences.push(...appendOnlyOffences(label, before, emitted.get(label)?.rows ?? []));
    }
    if (offences.length > 0) {
      console.error(`migration-ledger: ${offences.length} migration(s) the base branch shipped were edited or removed:\n`);
      for (const o of offences) console.error(`  ${o}`);
      console.error(
        '\nA scope that applied one records its digest and fails closed when the registered SQL differs\n' +
          '(#2066). Put the original back and add a new migration that makes the change.',
      );
      process.exit(1);
    }
    console.log(`migration-ledger: ${ledgers.length} base ledger(s) — every migration ${base} shipped is unchanged here.`);
    return;
  }

  const drift: string[] = [];
  const candidates = new Set([...packages.map((p) => p.label), ...emitted.keys()]);
  for (const label of [...candidates].sort()) {
    const path = join(label, LEDGER);
    const want = emitted.get(label)?.text;
    const have = existsSync(path) ? readFileSync(path, 'utf8') : undefined;
    if (want === have) continue;
    if (check) drift.push(want === undefined ? `${path}: authors no migrations, but the ledger exists` : `${path}: ${have === undefined ? 'missing' : 'stale'}`);
    else if (want !== undefined) writeFileSync(path, want);
  }
  if (check && drift.length > 0) {
    console.error(`migration-ledger: ${drift.length} ledger(s) out of step with the code:\n`);
    for (const d of drift) console.error(`  ${d}`);
    console.error('\nRegenerate with `pnpm lint:migration-ledger`; the diff is what a reviewer reads.');
    process.exit(1);
  }
  const rows = [...emitted.values()].reduce((n, l) => n + l.rows.length, 0);
  console.log(`migration-ledger: ${emitted.size} ledger(s), ${rows} authored migration(s)${check ? ', in step with the code' : ' written'}.`);
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  await main();
}
