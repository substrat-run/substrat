#!/usr/bin/env tsx
/**
 * The store script's entry module (#2289). The kind's class is not the script's
 * entry: this module is, and it checks the envelope before the kind is constructed.
 *
 * Bundled here, from `packages/control-plane-api/store-entry/entry.ts`, into a string
 * the uploader writes in front of the kind. The two placeholders are replaced per kind.
 *
 *   pnpm lint:store-entry            re-emit
 *   pnpm lint:store-entry --check    CI: exit 1 on drift
 */
import { build } from 'esbuild';
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import * as names from '../packages/control-plane-api/store-entry/names.ts';

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const SOURCE = 'packages/control-plane-api/store-entry/entry.ts';
const PYTHON = 'packages/store-entry-python/src/substrat_store_entry.py';
const OUT = 'packages/control-plane-api/src/store-entry.generated.ts';
const check = process.argv.includes('--check');

const result = await build({
  entryPoints: [join(ROOT, SOURCE)],
  bundle: true,
  format: 'esm',
  platform: 'neutral',
  target: 'es2022',
  write: false,
  external: ['cloudflare:workers', names.STORE_KIND_PLACEHOLDER],
  legalComments: 'none',
  charset: 'utf8',
  logLevel: 'silent',
});
const js = result.outputFiles[0]!.text;
if (!js.includes(names.STORE_KIND_PLACEHOLDER) || !js.includes(names.STORE_CLASS_PLACEHOLDER)) {
  console.error('store-entry: the bundle dropped a placeholder. The uploader would have nothing to replace.');
  process.exit(1);
}

// One constant per export of names.ts, with its doc comment, so the uploader and the entry share them.
const namesSource = readFileSync(join(ROOT, 'packages/control-plane-api/store-entry/names.ts'), 'utf8');
const constants = Object.entries(names)
  .map(([name, value]) => {
    const doc = namesSource.match(new RegExp(`(/\\*\\*(?:(?!\\*/)[\\s\\S])*\\*/)\\s*export const ${name} =`))?.[1];
    if (!doc) throw new Error(`store-entry: names.ts exports ${name} without a doc comment`);
    return `${doc}\nexport const ${name} = ${JSON.stringify(value)};`;
  })
  .join('\n\n');

const python = readFileSync(join(ROOT, PYTHON), 'utf8');

const generated = `// GENERATED by tools/store-entry-emit.mts from ${SOURCE} and ${PYTHON} — do not edit by hand.
// Re-emit with \`pnpm lint:store-entry\`; CI runs it with \`--check\`.

/**
 * The store script's entry (#2289), and the names it shares with the uploader
 * (store-entry/names.ts). The entry is uploaded as the script's main module. The kind
 * module replaces \`${names.STORE_KIND_PLACEHOLDER}\` and its class name replaces
 * \`${names.STORE_CLASS_PLACEHOLDER}\`.
 */

${constants}

/** The entry itself — ${js.length} bytes of ESM. */
export const STORE_ENTRY_SOURCE: string = ${JSON.stringify(js)};

/**
 * The Python entry (#2290). The same \`--check\` holds it. The upload replaces the
 * import marked \`__SUBSTRAT_STORE_KIND_IMPORT__\`.
 */
export const STORE_ENTRY_PYTHON_SOURCE: string = ${JSON.stringify(python)};
`;

const outPath = join(ROOT, OUT);
const current = existsSync(outPath) ? readFileSync(outPath, 'utf8') : '';
if (current === generated) {
  console.log(`store-entry: ${OUT} is current (${js.length} bytes).`);
  process.exit(0);
}
if (check) {
  console.error(
    `store-entry: ${OUT} is not what ${SOURCE} builds to.\n  Run \`pnpm lint:store-entry\` and commit the result.`,
  );
  process.exit(1);
}
writeFileSync(outPath, generated);
console.log(`store-entry: wrote ${OUT} (${js.length} bytes).`);
