{
  "entities": {
    "protocol": {
      "table": "protocol_instances",
      "fields": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "template_key": {
            "type": "string"
          },
          "template_version": {
            "type": "number"
          },
          "entity_type": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "pending_signature",
              "signed",
              "voided"
            ]
          },
          "created_by": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "voided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "voided_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "voided_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_ref_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_ref_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "bound_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "document_attachment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "frozen_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "frozen_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "template_key",
          "template_version",
          "entity_type",
          "entity_id",
          "status",
          "created_by",
          "created_at",
          "voided_by",
          "voided_reason",
          "voided_at",
          "content_ref_type",
          "content_ref_id",
          "bound_hash",
          "document_attachment_id",
          "frozen_hash",
          "frozen_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "lifecycles": {
    "protocol": {
      "field": "status",
      "initial": "open",
      "states": {
        "open": {
          "on": {
            "protocol/request-signatures": "pending_signature",
            "protocol/sign": "signed",
            "protocol/void": "voided"
          },
          "allow": [
            "protocol/bind-document",
            "protocol/fill"
          ],
          "extensible": true
        },
        "pending_signature": {
          "on": {
            "protocol/cancel-signatures": "open",
            "protocol/record-signature": "signed",
            "protocol/void": "voided"
          }
        },
        "signed": {
          "on": {
            "protocol/void": "voided"
          },
          "allow": [
            "protocol/countersign"
          ]
        },
        "voided": {
          "terminal": true
        }
      }
    }
  }
}
