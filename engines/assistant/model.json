        "properties": {
          "thread_id": {
            "type": "string"
          },
          "call_id": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "awaiting-approval",
              "approved",
              "denied",
              "executing",
              "done",
              "failed"
            ]
          },
          "digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "nonce": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_seq": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "subject_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "call_id",
          "tool",
          "state",
          "digest",
          "step",
          "operation",
          "version",
          "expires_at",
          "nonce",
          "request_seq",
          "decided_by",
          "decided_at",
          "subject_id",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "primaryKey": [
        "thread_id",
        "call_id"
      ],
      "erasable": [
        "decided_by",
        "subject_id"
      ],
      "erasure": {
        "mode": "delete",
        "subjects": [
          "subject_id"
        ]
      }
    }
  }
}
