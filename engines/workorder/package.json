{
  "name": "@substrat-run/engine-workorder",
  "version": "0.10.6",
  "description": "Substrat engine: work orders + time + material — one engine, one state machine, append-only reporting",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrat-run/substrat.git",
    "directory": "engines/workorder"
  },
  "homepage": "https://substrat.net/engines",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/kernel": "workspace:^"
  },
  "devDependencies": {
    "@substrat-run/contract-tests": "workspace:^",
    "@substrat-run/engine-test-kit": "workspace:^",
    "@substrat-run/model-emit": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.4.0"
  },
  "substrat": {
    "conformance": "test/conformance.ts"
  }
}
