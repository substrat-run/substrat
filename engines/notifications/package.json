{
  "name": "@substrat-run/engine-notifications",
  "version": "0.1.6",
  "private": true,
  "description": "Substrat engine: notifications — an occasion a vertical names becomes email to the people it concerns, through per-user preferences, escaped templates and tracked deliveries",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrat-run/substrat.git",
    "directory": "engines/notifications"
  },
  "homepage": "https://substrat.net/engines",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.workerd-test.json --noEmit",
    "test": "vitest run && vitest run -c vitest.workerd.config.ts"
  },
  "dependencies": {
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/kernel": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@substrat-run/adapter-cloudflare": "workspace:^",
    "@substrat-run/contract-tests": "workspace:^",
    "@substrat-run/engine-test-kit": "workspace:^",
    "@substrat-run/model-emit": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.4.0"
  },
  "substrat": {
    "conformance": "test/conformance.ts"
  }
}
