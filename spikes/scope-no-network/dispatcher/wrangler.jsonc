// The spike's front door (RUNBOOK.md step 3): an ordinary worker that hands each request to one of the
// two scripts in the spike's namespace, with the refusing outbound worker attached as the router does.
{
  "name": "substrat-spike-scope-net-dispatcher",
  "main": "index.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "dispatch_namespaces": [
    { "binding": "DISPATCH", "namespace": "substrat-spike-scope-net", "outbound": { "service": "substrat-spike-scope-net-outbound" } }
  ]
}
