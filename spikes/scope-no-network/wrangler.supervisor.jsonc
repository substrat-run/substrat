// The supervisor, uploaded to the spike's dispatch namespace (RUNBOOK.md step 2). A throwaway.
{
  "name": "substrat-spike-scope-net-supervisor",
  "main": "src/supervisor.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // The scope's code travels inert: Text modules the supervisor hands to the loader, never imports.
  "rules": [{ "type": "Text", "globs": ["**/scope.js", "**/exits.js", "**/pad.js"], "fallthrough": false }],
  "durable_objects": {
    "bindings": [
      { "name": "SUPERVISOR", "class_name": "Supervisor" },
      { "name": "OTHER", "class_name": "Other" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Supervisor", "Other"] }],
  "worker_loaders": [{ "binding": "LOADER" }]
}
