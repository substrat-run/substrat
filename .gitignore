node_modules/
dist/
*.tsbuildinfo
coverage/
.DS_Store
**/.vitepress/cache/
**/.vitepress/.temp/
.data/

# Design handoff bundles dropped in the repo root. The tokens, brand assets and
# component contracts they carry are ported into apps/console — the zip itself is
# a delivery vehicle, not a source, and a new revision lands with every iteration.
*.zip

# Cloudflare Workers build/dev artifacts
.wrangler/
dist-worker/
# Local dev secrets for wrangler (BETTER_AUTH_SECRET etc.)
.dev.vars
**/.dev.vars
demos/callout/wrangler.jsonc

# demo runtime data (seeded on every server start)
demos/rally/.data/
.env
**/.env

# Filled platform secret files (templates in secrets/*.example stay committed)
secrets/*.env

# Builder studio projects — each is its OWN git repo (builder-studio.md §4.6);
# never part of this repo. The nested .git keeps their history out of ours.
.builder/

# The create-substrat template, materialized against the workspace so a compiler
# sees it (#878, tools/template-sync.mjs). A copy of packages/create-substrat/
# template — rewritten on every run, never edited, never committed. The member's
# package.json (the dependency links) IS committed.
packages/template-check/src/
packages/template-check/test/
packages/template-check/tsconfig.json
packages/template-check/tsconfig.worker.json
packages/template-check/vitest.config.ts
packages/template-check/GENERATED.md

# ticket0 local model credentials
demos/*/.env

# The external-vertical example resolves from the REGISTRY, not the workspace, so
# installing it is what proves the published packages still compose. Anything a
# documented install writes there PINS that resolution — a lockfile, and pnpm's
# auto-written minimumReleaseAgeExclude list, which names exact versions — and a
# pinned example stops testing anything. Ignored rather than checked in. (The
# example is not a workspace member, so its pnpm-workspace.yaml is pnpm's own
# artifact, not a second workspace root anyone maintains.)
examples/external-vertical/package-lock.json
examples/external-vertical/pnpm-lock.yaml
examples/external-vertical/pnpm-workspace.yaml

# A scratch drawer for things that must never be committed: production exports, customer
# files, design archives, anything dropped here to look at locally.
#
# ANCHORED with a leading slash, deliberately. A bare `data/` would ignore a directory of
# that name ANYWHERE in the tree, so a vertical that one day keeps real source files in
# `demos/x/data/` would have them silently vanish from every diff — an ignore rule that
# hides code is worse than the exposure it was written to prevent.
#
# This repo is public. A production dump landing in it is readable the moment it is pushed
# and stays readable in the history after it is removed, which is why the drawer exists at
# all rather than people keeping such files loose in the root.
/data/
