# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION platform secrets — one flat file, pushed to every worker by
#   node scripts/secrets.mjs push --env prod
#
#   cp secrets/platform.prod.env.example secrets/platform.prod.env
#   node scripts/secrets.mjs generate                 # fill the random shared secrets
#   # …paste the external values below (OIDC, Cloudflare, GitHub App)…
#   node scripts/secrets.mjs check                    # confirm coverage (no values shown)
#   node scripts/secrets.mjs push --env prod          # upload via `wrangler secret bulk`
#
# secrets/*.env is gitignored — this .example is the only committed copy. Keep the
# filled file in a password manager; it is the source of truth for the account.
# See secrets/README.md for the full name-mapping (which key lands on which worker).
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared, must MATCH across workers (generatable: `secrets.mjs generate`) ──────
# service actor token: control-plane SERVICE_TOKEN == dashboard CP_SERVICE_TOKEN
SERVICE_TOKEN=
# provisioning credential the control plane holds and injects into every vertical
PLATFORM_SECRET=
# router↔vertical credential, held by control-plane + router (and injected)
ROUTER_SECRET=

# ── OIDC (AuthHero) — issuer is shared; each app is its OWN client ───────────────
# The AuthHero tenant issuer — must serve /.well-known/openid-configuration.
# Currently https://substrat.token.sesamy.dev. Do NOT use auth.substrat.run: that
# hostname does not exist (yet), and pushing it breaks all platform login with
# "OIDC discovery failed (530)" (2026-08-01 incident).
OIDC_ISSUER=
# console / control-plane client (redirect https://console.substrat.net/api/auth/callback)
CP_OIDC_CLIENT_ID=
CP_OIDC_CLIENT_SECRET=
# dashboard client (redirect https://app.substrat.net/api/auth/callback)
DASH_OIDC_CLIENT_ID=
DASH_OIDC_CLIENT_SECRET=

# ── Per-worker session signing keys (generatable; independent per worker) ────────
CP_SESSION_SECRET=
DASH_SESSION_SECRET=

# ── Control plane: git-import CI + Cloudflare-for-SaaS custom hostnames ──────────
# token a customer repo's CI presents to `substrat push` (generatable)
CP_PUSH_TOKEN_SECRET=
# signs the dashboard's tenant-scoped service credential (#1602; generatable) — set
# this on the control plane and deploy it BEFORE the dashboard that expects it
CP_TENANT_TOKEN_SECRET=
# Cloudflare API token — needs Workers Scripts:Edit (push), SSL and Certificates:Edit
# on the substrat.run zone (custom hostnames), AND D1:Edit (per-tenant stores, #301 —
# without it a vertical declaring `tenantStores` fails at provision with a D1 auth
# error). Missing SSL:Edit is why a custom domain lands `failed` ("403: Authentication
# error") with no CF hostname created. NOTE: it is an ACCOUNT-owned token (Manage
# Account → Account API Tokens, not My Profile), and a permission edit takes a few
# minutes to propagate — keep retrying before concluding the edit didn't land.
# NOT used for the lake, and do not add lake permissions to it: this token is pushed to the
# running control plane, and `pnpm lake:provision` can delete the audit lake. That script acts
# as your `wrangler login` instead (secrets/README.md). An exported CLOUDFLARE_API_TOKEN, or a
# CLOUDFLARE_API_KEY + CLOUDFLARE_EMAIL pair, overrides the login — the script prints `As:`.
CF_API_TOKEN=
CF_ACCOUNT_ID=8cbb7553a78d4d4bc4159906c77214a3
# the substrat.run zone id (Cloudflare → substrat.run → Overview → Zone ID)
CF_SAAS_ZONE_ID=
# AES-256 key sealing the CONNECTION DIRECTORY's provider credentials (#574) —
# `openssl rand -base64 32` (generatable). Deliberately independent of the
# dashboard's SECRET_BOX_KEY (different stores, independent rotation). NEVER
# rotate without keeping the old value: it orphans sealed connection secrets.
CP_SECRET_BOX_KEY=

# ── Dashboard: connection-credential encryption + GitHub App (repo import) ───────
# AES-256 key sealing stored connection credentials — `openssl rand -base64 32`
# (generatable). NEVER rotate without keeping the old value: it orphans sealed creds.
SECRET_BOX_KEY=
# GitHub App for the repo-import flow (absent ⇒ Git-import reports "not configured")
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PKCS#8 PEM, RS256. Single line with literal \n escapes, e.g.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=
# Must equal the App settings → Webhook page's secret. Unset ⇒ every per-PR preview
# webhook is rejected unverified, and the previews simply never appear.
GITHUB_APP_WEBHOOK_SECRET=

# ── Optional config (usually wrangler.jsonc `vars`; set to override) ─────────────
# CF_SAAS_ROUTING_TARGET=cname.substrat.run
# CF_SAAS_SSL_METHOD=http
# PLATFORM_BASE_DOMAINS is a checked-in wrangler.jsonc `vars` entry (#423) — do NOT
# set it here: a secret cannot share a name with a var, so the push would fail.
# SECRET_BOX_KEY_ID=sb1
# CP_SECRET_BOX_KEY_ID=sb1
# DASH_EMAIL_FROM=no-reply@send.substrat.net
# CP_EMAIL_FROM=no-reply@send.substrat.net
# DASH_CP_ACTOR=

# ── Retention windows (control plane) — UNSET means "never auto-delete" ──────────
# Each reap is irreversible, so the platform deletes nothing on a schedule a human
# did not choose. Integer days. Named here even while blank, so a deployment can see
# what it has NOT opted into (#990). Manual "reap now" from the console is unaffected.
# days an archived scope's DO storage is kept before the sweep wipes it
# CP_SCOPE_RETENTION_DAYS=
# days a tenant may sit in `deleting` before the sweep reaps it
# CP_TENANT_RETENTION_DAYS=
# days a reap's recoverable copy (scopes/… in SCOPE_BACKUPS) is kept — this is the
# ONLY recoverable form of a reaped scope's data, so choose it as deliberately as the
# reap window itself
# CP_SCOPE_BACKUP_RETENTION_DAYS=
# days a shipped access-log batch (access-log/… in DIRECTORY_BACKUPS) is kept
# CP_ACCESS_LOG_RETENTION_DAYS=

# ── Tier 2: the Iceberg lake (R2 Data Catalog + Pipelines) ───────────────────────
# The exact-history tier (D-5, kernel-design §5.3): the kernel outbox is shipped into
# an Iceberg table on R2 and read back with R2 SQL. Bucket `substrat-lake`, namespace
# `kernel`, table `events`; the Catalog URI and Warehouse name are on that bucket's
# Settings → R2 Data Catalog panel, and both embed CF_ACCOUNT_ID above.
#
# THREE different credentials, and they are NOT interchangeable:
#
#  1. CATALOG — an R2 token with **Admin Read & Write**, scoped to substrat-lake.
#     Cloudflare Pipelines commits catalog transactions with it. It is handed to
#     `scripts/lake-provision.mjs` once and then lives in the sink's own config, so
#     it is recorded here ONLY because Cloudflare never gives a token back — this is
#     the restore copy. It is never pushed to a worker (STORE_ONLY in secrets.mjs).
#     Object Read & Write does NOT work: that permission is S3-API-only, so a pipeline
#     holding one creates fine and then fails at its first catalog commit.
#  2. SQL — a SECOND R2 token, **Admin Read only**, scoped to substrat-lake. The query
#     gateway reads the lake with it, so this one IS pushed (control-plane →
#     R2_SQL_TOKEN). Deliberately read-only and deliberately not the catalog token: a
#     reader that can commit can rewrite history, which is the one thing this tier is
#     for. Catalog-vended R2 credentials inherit the token's storage permission, so
#     read-only has to be read-only on BOTH halves — which "Admin Read only" is.
#  3. SEND — a **Workers Pipeline Send** token (a Cloudflare API token, not an R2 one),
#     for POSTing to the stream's HTTP endpoint with `Authorization: Bearer …`. Needed
#     only by a sender OUTSIDE Workers: a curl proof, a one-off backfill. The shipper
#     runs in a platform worker and reaches the stream through a `[[pipelines]]`
#     binding, which carries no credential at all — prefer that and leave this blank.
#
# The Access Key ID / Secret Access Key an R2 token also hands you are for the
# S3-compatible API, which nothing on this path uses. Don't record them: the Secret
# Access Key is the SHA-256 of the token value, so they carry no information the token
# doesn't and widen the blast radius of this file for nothing.
R2_LAKE_CATALOG_TOKEN=
R2_LAKE_SQL_TOKEN=
R2_LAKE_SEND_TOKEN=
# No token for PROVISIONING the lake. `pnpm lake:provision` acts as your own `wrangler login` —
# the right credential for a rare, human act that can delete the audit lake (secrets/README.md).

# ── Account resource ids the wrangler configs do NOT name ────────────────────────
# Not credentials — opaque ids for resources in THIS account. They live here because
# this file is what an account is restored from, and because the committed
# `apps/*/wrangler.jsonc` deliberately name none of them: the repo is public and
# forkable, and an inherited `database_id` points at somebody else's database. A NAME
# (`substrat-verticals`, `substrat-scope-backups`) stays in the config, because a fork
# keeping it creates its own resource under that name and simply works.
#
# `tools/wrangler-config.mjs` substitutes these into `wrangler.generated.jsonc` at
# deploy, reading process.env first (CI holds them as GitHub Actions secrets) and this
# file second. It refuses to emit a config with an unresolved placeholder.
#
# wrangler d1 list  →  substrat-control-plane-auth / …-auth-test
CF_D1_AUTH_DB_ID=
CF_D1_AUTH_DB_ID_TEST=
# The Tier-2 outbox stream (#1334). `pnpm lake:check` prints it; it CHANGES on every
# `pnpm lake:provision --recreate`, and a stale value here means the control plane
# ships events nowhere until it is redeployed.
CF_PIPELINE_OUTBOX_STREAM_ID=

# ── Builder studio (staff-only, builder.substrat.net — #625) ─────────────────────
# AuthHero client for the builder; SESSION_SECRET generatable.
BUILDER_OIDC_CLIENT_ID=
BUILDER_OIDC_CLIENT_SECRET=
BUILDER_SESSION_SECRET=
# Model providers for the hosted studio (#626) — optional per provider
BUILDER_ANTHROPIC_API_KEY=
BUILDER_DASHSCOPE_API_KEY=
BUILDER_DASHSCOPE_BASE_URL=
# Workers AI (…/accounts/<id>/ai/v1); token = Workers AI permission ONLY
BUILDER_CLOUDFLARE_AI_BASE_URL=
BUILDER_CLOUDFLARE_AI_API_TOKEN=
# Narrow builder-ops token (Workers R2 Storage:Edit ONLY) — used by
# scripts/builder-provision.mjs for bucket versioning; never the CP token.
BUILDER_CF_API_TOKEN=

# The ticket0 desk's verification secret (Settings → Identity verification → Rotate).
# One canonical key for BOTH platform apps — they embed the same desk, and a desk
# verifies against exactly one secret. Unset ⇒ neither app carries a support bubble.
SUPPORT_WIDGET_SECRET=
