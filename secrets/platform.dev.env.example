# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV platform secrets → each worker's .dev.vars (loaded by `wrangler dev`).
#
#   cp secrets/platform.dev.env.example secrets/platform.dev.env
#   node scripts/secrets.mjs generate --file secrets/platform.dev.env   # fill blanks
#   node scripts/secrets.mjs dev                                        # write .dev.vars
#
# Dev values are throwaway — never reuse a prod secret here. Local platform previews
# usually run without real OIDC (VITE_DEV_MOCK / dev-actor), so the OIDC_* fields can
# stay blank unless you're exercising the real AuthHero round-trip against a localhost
# redirect. secrets/*.env and every .dev.vars are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Shared, must match across workers (generatable — safe throwaway values in dev)
SERVICE_TOKEN=
PLATFORM_SECRET=
ROUTER_SECRET=

# Session signing keys (generatable)
CP_SESSION_SECRET=
DASH_SESSION_SECRET=

# Dashboard connection-credential key (generatable; dev-only, no sealed prod data)
SECRET_BOX_KEY=
# Control-plane connection-directory key (#574; generatable, independent of the above)
CP_SECRET_BOX_KEY=

# OIDC — leave blank for mock/dev-actor previews; fill only to test the real round-trip
# against http://localhost:8787/api/auth/callback (CP) / http://localhost:8890/... (dash)
OIDC_ISSUER=
CP_OIDC_CLIENT_ID=
CP_OIDC_CLIENT_SECRET=
DASH_OIDC_CLIENT_ID=
DASH_OIDC_CLIENT_SECRET=

# Cloudflare-for-SaaS is off in dev (no zone) ⇒ custom binds stay `pending`. Leave blank.
# CF_API_TOKEN=
# CF_SAAS_ZONE_ID=

# GitHub App (fill only to exercise repo import locally)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=

# ── Builder studio (staff-only, builder.substrat.net — #625) ─────────────────────
# AuthHero client for the builder; SESSION_SECRET generatable.
BUILDER_OIDC_CLIENT_ID=
BUILDER_OIDC_CLIENT_SECRET=
BUILDER_SESSION_SECRET=
# Model providers for the hosted studio (#626) — optional per provider
BUILDER_ANTHROPIC_API_KEY=
BUILDER_DASHSCOPE_API_KEY=
BUILDER_DASHSCOPE_BASE_URL=
# Workers AI (…/accounts/<id>/ai/v1); token = Workers AI permission ONLY
BUILDER_CLOUDFLARE_AI_BASE_URL=
BUILDER_CLOUDFLARE_AI_API_TOKEN=
# Narrow builder-ops token (Workers R2 Storage:Edit ONLY) — used by
# scripts/builder-provision.mjs for bucket versioning; never the CP token.
BUILDER_CF_API_TOKEN=

# The local ticket0 desk's verification secret (Settings → Identity verification →
# Rotate). One canonical key for BOTH platform apps — they embed the same desk, and a
# desk verifies against exactly one secret. Unset ⇒ neither app carries a support bubble.
SUPPORT_WIDGET_SECRET=
