  "lifecycles": {
    "conversation": {
      "field": "state",
      "initial": "new",
      "states": {
        "closed": {
          "terminal": true
        },
        "new": {
          "on": {
            "ticket0/assign": "open",
            "ticket0/post-public-reply": "open",
            "ticket0/resolve": "resolved"
          },
          "allow": [
            "ticket0/ingest-message",
            "ticket0/merge",
            "ticket0/post-note",
            "ticket0/record-answer",
            "ticket0/record-assistant-failure",
            "ticket0/set-priority",
            "ticket0/tag-conversation",
            "ticket0/widget-post"
          ]
        },
        "open": {
          "on": {
            "ticket0/resolve": "resolved",
            "ticket0/snooze": "snoozed"
          },
          "allow": [
            "ticket0/assign",
            "ticket0/ingest-message",
            "ticket0/merge",
            "ticket0/post-note",
            "ticket0/post-public-reply",
            "ticket0/record-answer",
            "ticket0/record-assistant-failure",
            "ticket0/set-priority",
            "ticket0/tag-conversation",
            "ticket0/widget-post"
          ]
        },
        "resolved": {
          "on": {
            "ticket0/close": "closed",
            "ticket0/ingest-message": "open",
            "ticket0/post-public-reply": "open",
            "ticket0/widget-post": "open"
          },
          "allow": [
            "ticket0/post-note",
            "ticket0/set-priority",
            "ticket0/submit-csat",
            "ticket0/tag-conversation"
          ]
        },
        "snoozed": {
          "on": {
            "ticket0/ingest-message": "open",
            "ticket0/resolve": "resolved",
            "ticket0/wake": "open",
            "ticket0/widget-post": "open"
          },
          "allow": [
            "ticket0/assign",
            "ticket0/post-note",
            "ticket0/set-priority",
            "ticket0/tag-conversation"
          ]
        }
      }
    }
  }
}
