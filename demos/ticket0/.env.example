# Copy to `.env` (gitignored) to give the assistant a real model.
#
# The dev server IS the platform here, so this file holds what the platform holds in
# production: a credential per model PROVIDER, never per desk (#1054). Without one for
# the chosen provider, ticket0 runs the `offline/extractive` fallback: it retrieves the
# best-matching documentation section and quotes it. The demo works either way — the
# difference is generation, not plumbing.

# Which model answers, as provider:model. The default runs on Cloudflare's network.
# TICKET0_MODEL=cloudflare:@cf/meta/llama-3.1-8b-instruct

# Cloudflare Workers AI / AI Gateway — account-scoped endpoint + a token with Workers AI run.
# Deliberately NOT wrangler's CLOUDFLARE_API_TOKEN, so a deploy token is never used for inference.
# CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account id>/ai/v1
# CLOUDFLARE_AI_API_TOKEN=

# Other rows of the provider table, if you pick them:
# ANTHROPIC_API_KEY=
# SCALEWAY_API_KEY=

# Start with an empty inbox — no sample conversations, just what you create.
# The desks, roles, knowledge base and assistant are seeded either way.
# TICKET0_EMPTY=1
