# Copy to `.env` (gitignored) to give the assistant a real model.
#
# Without these, ticket0 runs the `offline/extractive` fallback: it retrieves the
# best-matching documentation section and quotes it. The demo works either way —
# the difference is generation, not plumbing.

# Cloudflare Workers AI. The token needs "Workers AI: Read" on the account.
# CF_ACCOUNT_ID=
# CF_AI_TOKEN=

# Optional — the default is @cf/meta/llama-3.1-8b-instruct
# TICKET0_MODEL=@cf/meta/llama-3.1-8b-instruct

# Start with an empty inbox — no sample conversations, just what you create.
# The desks, roles, knowledge base and assistant are seeded either way.
# TICKET0_EMPTY=1
