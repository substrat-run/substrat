    "/api/op/manyfold/save-type": {
      "post": {
        "operationId": "manyfold-save-type",
        "summary": "Create or update a content type — every save bumps its version.",
        "description": "Requires `content:admin`.",
        "tags": [
          "Modelling"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "titleField": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slugField": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9]*$"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "text",
                            "richText",
                            "slug",
                            "bool",
                            "int",
                            "date",
                            "enum",
                            "textArray",
                            "assetRef",
                            "assetRefMany",
                            "ref",
                            "refMany"
                          ]
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "index": {
                          "type": "boolean"
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "target": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string"
                        },
                        "maxLen": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "type"
                      ]
                    }
                  }
                },
                "required": [
                  "key",
                  "title",
                  "titleField",
                  "fields"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The operation result."
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
