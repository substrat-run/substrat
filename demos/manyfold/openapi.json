{
  "openapi": "3.1.0",
  "info": {
    "title": "Manyfold CMS API",
    "version": "0.0.1",
    "description": "The Manyfold demo vertical — a multi-scope headless CMS (draft→review→publish lifecycle, append-only revisions, freeze-on-publish, data-defined content types) on the Substrat kernel. Every operation checks a permission for the calling principal."
  },
  "paths": {
    "/api/op/manyfold/create-entry": {
      "post": {
        "operationId": "manyfold-create-entry",
        "summary": "Create an entry (draft revision 1).",
        "description": "Requires `content:author`. `body` is validated against the content type’s own field schema.",
        "tags": [
          "Authoring"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "typeKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body": {}
                },
                "required": [
                  "typeKey",
                  "body"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The operation result."
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/op/manyfold/save-draft": {
      "post": {
        "operationId": "manyfold-save-draft",
        "summary": "Save a new draft revision (append-only — an edit is a new revision).",
        "description": "Requires `content:author`. Only `draft` or `unpublished` entries take new revisions.",
        "tags": [
          "Authoring"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "entryId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body": {}
                },
                "required": [
                  "entryId",
                  "body"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The operation result."
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/op/manyfold/restore-revision": {
      "post": {
        "operationId": "manyfold-restore-revision",
        "summary": "Restore an old revision — as a new revision, never a mutation of history.",
        "description": "Requires `content:author`.",
        "tags": [
          "Authoring"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "entryId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revNo": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "entryId",
                  "revNo"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The operation result."
          },
          "400": {
