{
  "name": "@substrat-run/demo-manyfold",
  "version": "0.7.10",
  "private": true,
  "license": "Apache-2.0",
  "description": "CMS demo vertical (Manyfold) — multi-scope headless CMS, see spec/concept.md",
  "substrat": {
    "slug": "manyfold",
    "name": "Manyfold",
    "permissions": "src/provision.ts",
    "conformance": "test/conformance.ts",
    "entitlements": [
      "manyfold"
    ],
    "ownerGrants": [
      "content:read",
      "content:author",
      "content:review",
      "content:publish",
      "content:admin"
    ],
    "surfaces": [
      {
        "name": "app",
        "label": "App"
      }
    ],
    "envSpec": [
      {
        "key": "AUTH_PROVIDER",
        "label": "Auth provider",
        "description": "OIDC-only: the vertical runs no built-in credential store. When no per-scope `substrat:auth` choice is delivered, 'oidc' verifies bearer tokens against OIDC_ISSUER (standalone deploys); anything else leaves the instance without a configured issuer.",
        "placeholder": "oidc",
        "default": "oidc",
        "required": false,
        "secret": false,
        "group": "Auth"
      },
      {
        "key": "OIDC_ISSUER",
        "label": "OIDC issuer",
        "description": "The issuer URL bearer tokens are verified against when the provider is 'oidc'. Covers Supabase, Auth0, AuthHero, Keycloak, …",
        "placeholder": "https://auth.example.com",
        "required": false,
        "secret": false,
        "group": "Auth"
      },
      {
        "key": "OIDC_AUDIENCE",
        "label": "OIDC audience",
        "description": "Expected `aud` claim of verified bearer tokens (optional; issuer-dependent).",
        "placeholder": "https://api.example.com",
        "required": false,
        "secret": false,
        "group": "Auth"
      }
    ],
    "tenant": "substrat-9yjbbn",
    "devServers": [
      {
        "name": "issuer",
        "run": "issuer",
        "portEnv": "ISSUER_PORT",
        "portFrom": "../../packages/dev-issuer/src/cli.ts"
      },
      {
        "name": "api",
        "run": "server",
        "portEnv": "PORT",
        "portFrom": "src/server.ts"
      },
      {
        "name": "web",
        "run": "dev",
        "dir": "app",
        "portEnv": "WEB_PORT",
        "portFrom": "app/vite.config.ts"
      }
    ]
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./module": "./src/module.ts"
  },
  "scripts": {
    "gen:assets": "node scripts/gen-assets.mjs",
    "pretypecheck": "node scripts/gen-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "server": "tsx src/server.ts",
    "dev": "concurrently -n issuer,api,web -c magenta,blue,green \"pnpm run issuer\" \"tsx src/server.ts\" \"pnpm --dir app dev\"",
    "demo": "pnpm run dev",
    "cf:dev": "wrangler dev --var ALLOW_DEV_NODE:true",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist-worker",
    "issuer": "tsx ../../packages/dev-issuer/src/cli.ts --personas src/personas.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@substrat-run/adapter-cloudflare": "workspace:^",
    "@substrat-run/adapter-sqlite": "workspace:^",
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/dev-issuer": "workspace:^",
    "@substrat-run/kernel": "workspace:^",
    "@substrat-run/vertical-auth": "workspace:^",
    "@substrat-run/vertical-host": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.12.32",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@substrat-run/contract-tests": "workspace:^",
    "@cloudflare/workers-types": "catalog:",
    "@scalar/api-reference": "^1.64.0",
    "@substrat-run/model-emit": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
