{
  "name": "@substrat-run/demo-manyfold",
  "version": "0.6.3",
  "private": true,
  "license": "Apache-2.0",
  "description": "CMS demo vertical (Manyfold) — multi-scope headless CMS, see spec/concept.md",
  "substrat": {
    "slug": "manyfold",
    "name": "Manyfold",
    "permissions": "src/provision.ts",
    "entitlements": [
      "manyfold"
    ],
    "ownerGrants": [
      "content:read",
      "content:author",
      "content:review",
      "content:publish",
      "content:admin"
    ],
    "surfaces": [
      {
        "name": "app",
        "label": "App"
      }
    ],
    "tenant": "substrat-9yjbbn"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./module": "./src/module.ts"
  },
  "scripts": {
    "gen:assets": "node scripts/gen-assets.mjs",
    "pretypecheck": "node scripts/gen-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "server": "tsx src/server.ts",
    "dev": "concurrently -n api,web -c blue,green \"tsx src/server.ts\" \"pnpm --dir app dev\"",
    "demo": "pnpm run dev",
    "cf:dev": "wrangler dev --var ALLOW_DEV_HEADER:true",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist-worker"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@substrat-run/adapter-cloudflare": "workspace:^",
    "@substrat-run/adapter-sqlite": "workspace:^",
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/kernel": "workspace:^",
    "@substrat-run/vertical-auth": "workspace:^",
    "@substrat-run/vertical-host": "workspace:^",
    "better-sqlite3": "^13.0.2",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@scalar/api-reference": "^1.64.0",
    "@types/better-sqlite3": "^7.6.13",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  }
}
