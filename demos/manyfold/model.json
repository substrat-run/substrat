{
  "entities": {
    "manyfold-entry": {
      "table": "manyfold_entry",
      "fields": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type_key": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "published",
              "unpublished",
              "archived"
            ]
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "draft_rev": {
            "type": "number"
          },
          "published_rev": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type_key",
          "status",
          "slug",
          "draft_rev",
          "published_rev",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "lifecycles": {
    "manyfold-entry": {
      "field": "status",
      "initial": "draft",
      "states": {
        "approved": {
          "on": {
            "manyfold/archive": "archived",
            "manyfold/publish": "published",
            "manyfold/submit-for-review": "in_review"
          }
        },
        "archived": {
          "terminal": true
        },
        "draft": {
          "on": {
            "manyfold/archive": "archived",
            "manyfold/submit-for-review": "in_review"
          }
        },
        "in_review": {
          "on": {
            "manyfold/approve": "approved",
            "manyfold/archive": "archived",
            "manyfold/reject": "draft"
          }
        },
        "published": {
          "on": {
            "manyfold/archive": "archived",
            "manyfold/unpublish": "unpublished"
          }
        },
        "unpublished": {
          "on": {
            "manyfold/archive": "archived",
            "manyfold/submit-for-review": "in_review"
          }
        }
      }
    }
  }
}
