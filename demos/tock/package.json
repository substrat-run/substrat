    "@substrat-run/adapter-sqlite": "workspace:^",
    "@substrat-run/contract-tests": "workspace:^",
    "@substrat-run/model-emit": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "substrat": {
    "slug": "tock",
    "name": "Tock",
    "permissions": "src/provision.ts",
    "conformance": "test/conformance.ts"
