{
  "name": "@substrat-run/demo-tock",
  "version": "0.0.3",
  "private": true,
  "description": "Turning delivered files into numbers you can stand behind — declared schemas, observed arrivals, runs that supersede",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "emit:migrations": "tsx tools/emit-migrations.mts",
    "test": "vitest run",
    "dev": "concurrently -n issuer,api,web -c magenta,blue,green \"pnpm run issuer\" \"tsx src/server.ts\" \"pnpm --dir app dev\"",
    "server": "tsx src/server.ts",
    "demo": "pnpm run dev",
    "issuer": "tsx ../../packages/dev-issuer/src/cli.ts --personas src/personas.ts"
  },
  "dependencies": {
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/kernel": "workspace:^",
    "zod": "catalog:",
    "@hono/node-server": "^1.13.0",
    "@substrat-run/adapter-sqlite": "workspace:^",
    "@substrat-run/dev-issuer": "workspace:^",
    "@substrat-run/vertical-host": "workspace:^",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@substrat-run/contract-tests": "workspace:^",
    "@substrat-run/model-emit": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "concurrently": "^9.0.0"
  },
  "substrat": {
    "slug": "tock",
    "name": "Tock",
    "permissions": "src/provision.ts",
    "conformance": "test/conformance.ts",
    "devServers": [
      {
        "name": "issuer",
        "run": "issuer",
        "portEnv": "ISSUER_PORT",
        "portFrom": "../../packages/dev-issuer/src/cli.ts"
      },
      {
        "name": "api",
        "run": "server",
        "portEnv": "PORT",
        "portFrom": "src/server.ts"
      },
      {
        "name": "web",
        "run": "dev",
        "dir": "app",
        "portEnv": "WEB_PORT",
        "portFrom": "app/vite.config.ts"
      }
    ],
    "client": {
      "model": "spec/model.ts",
      "entities": "tockEntities",
      "operations": "tockOperations",
      "out": "app/src/api.generated.ts",
      "name": "Tock"
    }
  }
}
