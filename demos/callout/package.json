{
  "name": "@substrat-run/demo-callout",
  "version": "0.3.5",
  "private": true,
  "license": "Apache-2.0",
  "description": "FSM demo vertical (Callout) — see spec/testrun.md",
  "substrat": {
    "slug": "callout",
    "name": "Callout",
    "permissions": "src/provision.ts",
    "conformance": "test/conformance.ts",
    "client": {
      "model": [
        "src/entities.ts",
        "src/operations.ts",
        "@substrat-run/engine-workorder",
        "@substrat-run/engine-protocol",
        "@substrat-run/engine-invoicing",
        "@substrat-run/contracts"
      ],
      "entities": [
        "calloutEntities",
        "workorderEntities",
        "protocolEntities",
        "invoicingEntities"
      ],
      "schemas": {
        "Price": "priceRow",
        "Money": "money",
        "WorkOrder": "workOrder",
        "BillableLine": "billableLine",
        "MaterialLine": "materialLine",
        "ProtocolInstance": "protocolInstanceRow",
        "ProtocolTemplateRow": "protocolTemplateRow",
        "ProtocolResponse": "protocolResponseRow",
        "ProtocolSignature": "protocolSignatureRow",
        "ProtocolSignatureRequest": "protocolSignatureRequestRow",
        "UnderlagLine": "underlagLine",
        "UnderlagListRow": "underlagListRow"
      },
      "operations": [
        "calloutOperations",
        "calloutEngineRoutes",
        "calloutProtocolRoutes",
        "calloutInvoicingRoutes"
      ],
      "out": "app/src/api.generated.ts",
      "name": "Callout",
      "types": {
        "protocol/define-template.input.content": "unknown"
      }
    },
    "requires": [
      "oidc-issuer"
    ],
    "envSpec": [
      {
        "key": "AUTH_PROVIDER",
        "label": "Auth provider",
        "description": "OIDC-only: the vertical runs no built-in credential store. When no per-scope `substrat:auth` choice is delivered, 'oidc' verifies bearer tokens against OIDC_ISSUER (standalone deploys); anything else leaves the instance without a configured issuer.",
        "placeholder": "oidc",
        "default": "oidc",
        "required": false,
        "secret": false,
        "group": "Auth"
      },
      {
        "key": "OIDC_ISSUER",
        "label": "OIDC issuer",
        "description": "The issuer URL bearer tokens are verified against when the provider is 'oidc'. Covers Supabase, Auth0, AuthHero, Keycloak, …",
        "placeholder": "https://auth.example.com",
        "required": false,
        "secret": false,
        "group": "Auth"
      },
      {
        "key": "OIDC_AUDIENCE",
        "label": "OIDC audience",
        "description": "Expected `aud` claim of verified bearer tokens (optional; issuer-dependent).",
        "placeholder": "https://api.example.com",
        "required": false,
        "secret": false,
        "group": "Auth"
      }
    ],
    "devServers": [
      {
        "name": "issuer",
        "run": "issuer",
        "portEnv": "ISSUER_PORT",
        "portFrom": "../../packages/dev-issuer/src/cli.ts"
      },
      {
        "name": "api",
        "run": "server",
        "portEnv": "PORT",
        "portFrom": "src/server.ts"
      },
      {
        "name": "web",
        "run": "dev",
        "dir": "app",
        "portEnv": "WEB_PORT",
        "portFrom": "app/vite.config.ts"
      }
    ]
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./module": "./src/module.ts"
  },
  "scripts": {
    "gen:assets": "node scripts/gen-assets.mjs",
    "pretypecheck": "node scripts/gen-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "preserver": "node ../../tools/env-preflight.mjs server",
    "server": "node --env-file-if-exists=.dev.vars --import tsx src/server.ts",
    "dev": "concurrently -n issuer,api,web -c magenta,blue,green \"pnpm run issuer\" \"pnpm run server\" \"pnpm --dir app dev\"",
    "demo": "pnpm run dev",
    "cf:dev": "wrangler dev --var ALLOW_DEV_NODE:true",
    "cf:deploy": "node ../../tools/preflight-migrations.mjs && wrangler deploy",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist-worker",
    "issuer": "tsx ../../packages/dev-issuer/src/cli.ts --personas src/personas.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@substrat-run/adapter-cloudflare": "workspace:^",
    "@substrat-run/adapter-sqlite": "workspace:^",
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/control-plane-api": "workspace:^",
    "@substrat-run/dev-issuer": "workspace:^",
    "@substrat-run/engine-invoicing": "workspace:^",
    "@substrat-run/engine-protocol": "workspace:^",
    "@substrat-run/engine-workorder": "workspace:^",
    "@substrat-run/kernel": "workspace:^",
    "@substrat-run/vertical-auth": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@substrat-run/contract-tests": "workspace:^",
    "@substrat-run/model-emit": "workspace:*",
    "@substrat-run/vertical-host": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
