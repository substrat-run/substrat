{
  "name": "@substrat-run/demo-callout",
  "version": "0.2.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "FSM demo vertical (Callout) — see spec/testrun.md",
  "substrat": {
    "slug": "callout",
    "name": "Callout",
    "permissions": "src/provision.ts",
    "requires": [
      "oidc-issuer"
    ],
    "envSpec": [
      {
        "key": "AUTH_PROVIDER",
        "label": "Auth provider",
        "description": "OIDC-only: the vertical runs no built-in credential store. When no per-scope `substrat:auth` choice is delivered, 'oidc' verifies bearer tokens against OIDC_ISSUER (standalone deploys); anything else leaves the instance without a configured issuer.",
        "placeholder": "oidc",
        "default": "oidc",
        "required": false,
        "secret": false,
        "group": "Auth"
      },
      {
        "key": "OIDC_ISSUER",
        "label": "OIDC issuer",
        "description": "The issuer URL bearer tokens are verified against when the provider is 'oidc'. Covers Supabase, Auth0, AuthHero, Keycloak, …",
        "placeholder": "https://auth.example.com",
        "required": false,
        "secret": false,
        "group": "Auth"
      },
      {
        "key": "OIDC_AUDIENCE",
        "label": "OIDC audience",
        "description": "Expected `aud` claim of verified bearer tokens (optional; issuer-dependent).",
        "placeholder": "https://api.example.com",
        "required": false,
        "secret": false,
        "group": "Auth"
      }
    ]
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./module": "./src/module.ts"
  },
  "scripts": {
    "gen:assets": "node scripts/gen-assets.mjs",
    "pretypecheck": "node scripts/gen-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "server": "tsx src/server.ts",
    "dev": "concurrently -n api,web -c blue,green \"ALLOW_DEV_HEADER=true tsx src/server.ts\" \"pnpm --dir app dev\"",
    "demo": "pnpm run dev",
    "cf:dev": "wrangler dev --var ALLOW_DEV_HEADER:true",
    "cf:deploy": "node ../../tools/preflight-migrations.mjs && wrangler deploy",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist-worker"
  },
  "dependencies": {
    "@substrat-run/adapter-cloudflare": "workspace:^",
    "@substrat-run/adapter-sqlite": "workspace:^",
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/control-plane-api": "workspace:^",
    "@substrat-run/engine-invoicing": "workspace:^",
    "@substrat-run/engine-protocol": "workspace:^",
    "@substrat-run/engine-workorder": "workspace:^",
    "@substrat-run/kernel": "workspace:^",
    "@substrat-run/vertical-auth": "workspace:^",
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/better-sqlite3": "^7.6.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.110.0"
  }
}
