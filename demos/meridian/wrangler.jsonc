{
	"name": "substrat-meridian",
	"main": "src/worker.ts",
	"compatibility_date": "2025-01-01",
	// Better Auth (end-user sign-in) needs Node built-ins on workerd.
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	// Build the SPA before bundling. Wrangler runs this on every `wrangler dev` /
	// `--dry-run` — including the `--dry-run` a `substrat push` performs — so a push always
	// ships the current UI with no extra step. The second step copies the self-hosted
	// /api/docs renderer in beside it (it is not part of the SPA's import graph).
	"build": {
		"command": "pnpm --dir app build && node scripts/copy-docs-renderer.mjs"
	},
	// Static files, served from the edge (#340). NOT a binding — native assets are a
	// top-level upload path, which is why they pass the §4 sandbox contract without riding
	// its binding allowlist (self-serve-deploy.md §4.1, D-44). The SPA used to be base64-
	// inlined into this worker's bundle; it now goes up Cloudflare's asset upload session
	// and is served without invoking the worker at all.
	//
	// The two routing fields are load-bearing together:
	//   - `single-page-application` sends any non-file path to index.html, so a deep client
	//     route (/employees/123) resolves instead of 404ing.
	//   - which would ALSO swallow this worker's own routes — they are not files either —
	//     so every prefix the worker owns is listed as worker-first. Anything added to the
	//     worker under a new prefix must be added here too, or the SPA will answer it.
	//
	// One behavioural difference from the hand-rolled `serveAsset` this replaces: a missing
	// path that LOOKS like a file (/logo.png) used to 404, because that catch-all sniffed
	// for an extension. The runtime's SPA mode has no such special case — every unmatched
	// path gets index.html. That is the standard semantics on every SPA host, and the
	// extension sniff was our approximation of it, so it goes rather than being rebuilt.
	"assets": {
		"directory": "./app/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/internal/*", "/openapi.json"]
	},
	// A SANDBOX-CLEAN, control-plane-less vertical (scope-local-permissions.md Phase 3):
	// its ONLY bindings are its own SCOPE DO class and AUTH_DB. No CONTROL_PLANE binding,
	// no service binding to a platform worker, no ASSETS binding — assertSandboxContract
	// (control-plane-api/deploy.ts) refuses those, and the push would be rejected. The
	// router asserts the node; permissions evaluate from each scope's own storage.
	// Two OWN DO classes: SCOPE (business data, one per scope) and AUTH (identity —
	// Better Auth over its own DO SQLite, one per tenant). No shared D1 `AUTH_DB`: a
	// tenant's users/sessions/credentials are isolated in its AUTH DO, and there is no
	// per-worker auth database to leak across tenants. Both are the vertical's OWN
	// classes, so the sandbox contract permits the bindings.
	"durable_objects": {
		"bindings": [
			{ "name": "SCOPE", "class_name": "ScopeDO" },
			{ "name": "AUTH", "class_name": "IdentityDO" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ScopeDO", "IdentityDO"]
		}
	]
	// Secrets on deploy (`wrangler secret put …` / injected by the platform on push):
	//   ROUTER_SECRET    — the router's, gates the routed request path (K-26)
	//   PLATFORM_SECRET  — the control plane's, gates /internal/provision + /internal/link (K-31)
	// No SERVICE_TOKEN / CONTROL_PLANE_URL — a CP-less vertical calls no control plane.
	// ALLOW_DEV_HEADER is set by `pnpm cf:dev` for local use only, so a real deploy stays
	// fail-closed. Scrive is NOT wired in the pushed worker: the TIMER half is solved
	// (definePlatformSweeperDO in @substrat-run/adapter-cloudflare — a DO alarm, which
	// unlike a cron does run in a dispatch user-worker), but a CP-less vertical holds no
	// connection directory for the sweep to enumerate (listConnections), so it remains a
	// standalone-mode feature until connections are reachable from the vertical's runtime.
}
