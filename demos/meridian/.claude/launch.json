{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 8875,
      "env": {
        "ALLOW_DEV_HEADER": "true"
      },
      "autoPort": false
    },
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "app",
        "dev"
      ],
      "port": 5275,
      "autoPort": false
    }
  ]
}
