{
  "name": "@substrat-run/demo-shop",
  "version": "0.2.4",
  "private": true,
  "substrat": {
    "permissions": "src/seed.ts",
    "conformance": "test/conformance.ts",
    "devServers": [
      {
        "name": "api",
        "run": "server",
        "portEnv": "PORT",
        "portFrom": "src/server.ts"
      },
      {
        "name": "web",
        "run": "dev",
        "dir": "app",
        "portEnv": "WEB_PORT",
        "portFrom": "app/vite.config.ts"
      },
      {
        "name": "admin",
        "run": "dev",
        "dir": "admin",
        "portEnv": "ADMIN_PORT",
        "portFrom": "admin/vite.config.ts"
      }
    ]
  },
  "license": "Apache-2.0",
  "description": "E-commerce demo vertical (Kallkälla Kaffe) — see spec/concept.md",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "server": "tsx src/server.ts",
    "dev": "concurrently -n api,web,admin -c blue,green,magenta \"tsx src/server.ts\" \"pnpm --dir app dev\" \"pnpm --dir admin dev\"",
    "demo": "pnpm run dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@substrat-run/adapter-sqlite": "workspace:^",
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/engine-invoicing": "workspace:^",
    "@substrat-run/kernel": "workspace:^",
    "@substrat-run/vertical-host": "workspace:^",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@substrat-run/contract-tests": "workspace:^",
    "@substrat-run/model-emit": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "catalog:"
  }
}
