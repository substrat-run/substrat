{
  "name": "@substrat-run/demo-auth-server",
  "version": "0.9.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Standalone Better Auth OIDC provider demo (auth-server) — see spec/concept.md",
  "substrat": {
    "slug": "auth-server",
    "name": "Auth Server",
    "permissions": "src/permissions.ts",
    "tenant": "substrat-9yjbbn",
    "provides": [
      "oidc-issuer"
    ],
    "sendsEmail": true,
    "devServers": [
      {
        "name": "api",
        "run": "server",
        "portEnv": "PORT",
        "portFrom": "src/server.ts"
      },
      {
        "name": "app",
        "run": "dev",
        "dir": "app",
        "portEnv": "WEB_PORT",
        "portFrom": "app/vite.config.ts"
      }
    ]
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen:assets": "node scripts/gen-assets.mjs",
    "pretypecheck": "node scripts/gen-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.workerd-test.json --noEmit",
    "test": "vitest run && vitest run -c vitest.workers.config.ts",
    "server": "tsx src/server.ts",
    "dev": "concurrently -n api,app -c blue,green \"tsx src/server.ts\" \"pnpm --dir app dev\"",
    "cf:dev": "wrangler dev",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist-worker",
    "gen:schema": "tsx scripts/gen-schema.mts"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.3",
    "@better-auth/oauth-provider": "^1.7.3",
    "@hono/node-server": "^1.13.0",
    "@substrat-run/adapter-email": "workspace:^",
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/kernel": "workspace:^",
    "better-auth": "^1.7.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@substrat-run/cli": "workspace:^",
    "@substrat-run/vertical-auth": "workspace:^",
    "@substrat-run/vertical-host": "workspace:^",
    "@types/better-sqlite3": "^9.6.0",
    "concurrently": "^9.0.0",
    "jose": "^6.2.3",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
