{
  "name": "@substrat-run/demo-rally",
  "version": "0.0.83",
  "private": true,
  "substrat": {
    "permissions": "src/seed.ts",
    "devServers": [
      {
        "name": "api",
        "run": "server",
        "portEnv": "PORT",
        "portFrom": "src/server.ts"
      },
      {
        "name": "player",
        "run": "dev",
        "dir": "app",
        "portEnv": "PLAYER_PORT",
        "portFrom": "app/vite.config.ts"
      },
      {
        "name": "console",
        "run": "dev",
        "dir": "admin",
        "portEnv": "CONSOLE_PORT",
        "portFrom": "admin/vite.config.ts"
      }
    ]
  },
  "license": "Apache-2.0",
  "description": "RallyPoint demo vertical (padel/tennis club booking) — see spec/concept.md",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "server": "tsx src/server.ts",
    "dev": "concurrently -n api,player,console -c blue,green,magenta \"tsx src/server.ts\" \"pnpm --dir app dev\" \"pnpm --dir admin dev\"",
    "demo": "pnpm run dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@substrat-run/adapter-sqlite": "workspace:^",
    "@substrat-run/contracts": "workspace:^",
    "@substrat-run/engine-booking": "workspace:^",
    "@substrat-run/engine-invites": "workspace:^",
    "@substrat-run/engine-invoicing": "workspace:^",
    "@substrat-run/kernel": "workspace:^",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@substrat-run/model-emit": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "catalog:"
  }
}
