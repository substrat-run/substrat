      "source": "vertical"
    },
    {
      "key": "receptionist",
      "permissions": [
        "booking:cancel",
        "booking:complete",
        "booking:confirm",
        "booking:create",
        "booking:hold",
        "booking:move",
        "booking:read",
        "rally:browse",
        "rally:manage-members",
