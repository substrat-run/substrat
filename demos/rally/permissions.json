{
  "permissions": [
    {
      "key": "booking:cancel",
      "description": "Cancel a reservation or leave one",
      "declaredBy": [
        "@substrat-run/engine-booking"
      ]
    },
    {
      "key": "booking:complete",
      "description": "Start service, complete, or mark a no-show",
      "declaredBy": [
        "@substrat-run/engine-booking"
      ]
    },
    {
      "key": "booking:confirm",
      "description": "Confirm a held reservation",
      "declaredBy": [
        "@substrat-run/engine-booking"
      ]
    },
    {
      "key": "booking:create",
      "description": "Create reservations",
      "declaredBy": [
        "@substrat-run/engine-booking"
      ]
    },
    {
      "key": "booking:hold",
      "description": "Place a tentative hold on a slot",
      "declaredBy": [
        "@substrat-run/engine-booking"
      ]
    },
    {
      "key": "booking:manage-resources",
      "description": "Create, edit and deactivate bookable resources",
      "declaredBy": [
        "@substrat-run/engine-booking"
      ]
    },
    {
      "key": "booking:move",
      "description": "Reschedule a reservation to another slot or resource",
      "declaredBy": [
        "@substrat-run/engine-booking"
      ]
    },
    {
      "key": "booking:read",
      "description": "Read resources, reservations and availability",
      "declaredBy": [
        "@substrat-run/engine-booking"
      ]
    },
    {
      "key": "invites:read",
      "description": "List invitations and their state",
      "declaredBy": [
        "@substrat-run/engine-invites"
      ]
    },
    {
      "key": "invites:revoke",
      "description": "Withdraw an invitation before it is accepted",
      "declaredBy": [
        "@substrat-run/engine-invites"
      ]
    },
    {
      "key": "invites:send",
      "description": "Invite someone to an organization",
      "declaredBy": [
        "@substrat-run/engine-invites"
      ]
    },
    {
      "key": "invoicing:export",
      "description": "Export an invoice basis (makes it immutable)",
      "declaredBy": [
        "@substrat-run/engine-invoicing"
      ]
    },
    {
      "key": "invoicing:read",
      "description": "Read invoice bases",
      "declaredBy": [
        "@substrat-run/engine-invoicing"
      ]
    },
    {
      "key": "rally:browse",
      "description": "See courts, opening hours and free slots — free/busy only, never who booked",
      "declaredBy": [
        "@substrat-run/demo-rally"
      ]
    },
    {
      "key": "rally:manage-members",
      "description": "Manage club members and their records",
      "declaredBy": [
        "@substrat-run/demo-rally"
      ]
    },
    {
      "key": "rally:manage-pricing",
      "description": "Manage price rules, credit packs and subscription plans",
      "declaredBy": [
        "@substrat-run/demo-rally"
      ]
    },
    {
      "key": "rally:manage-venue",
      "description": "Set club and court opening hours, closures, and maintenance blocks",
      "declaredBy": [
        "@substrat-run/demo-rally"
      ]
    },
    {
      "key": "rally:wallet",
      "description": "Buy club credit and pay for a booking from a club balance",
      "declaredBy": [
        "@substrat-run/demo-rally"
      ]
    }
