        "booking:confirm",
        "booking:create",
        "booking:hold",
        "booking:manage-resources",
        "booking:move",
        "booking:read",
        "invites:read",
        "invites:revoke",
        "invites:send",
        "invoicing:export",
        "invoicing:read",
