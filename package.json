{
  "name": "substrat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "concurrently -k -n control-plane,console -c yellow,magenta \"pnpm --filter @substrat-run/control-plane-api dev\" \"pnpm --filter @substrat-run/console dev\"",
    "build": "pnpm -r --filter='!./.builder/projects/**' build",
    "lint:boundaries": "node tools/boundary-lint.mjs",
    "lint:cycles": "node tools/workspace-cycles.mjs",
    "lint:lockfile": "node tools/lockfile-scratch.mjs",
    "lint:deps": "node tools/declared-deps.mjs",
    "lint:generated-marks": "node tools/generated-marks.mjs",
    "lint:spine-ddl": "node tools/spine-ddl-drift.mjs",
    "lint:lake-schema": "node tools/lake-schema-emit.mjs",
    "lint:bound-fetch": "node tools/bound-fetch.mjs",
    "lint:vite-proxy": "node tools/vite-proxy-host.mjs",
    "lint:like-pattern": "node tools/like-pattern-length.mjs",
    "lint:invocation-log": "node tools/invocation-log.mjs",
    "lint:host-permissions": "node tools/host-permissions.mjs",
    "lint:skills": "node tools/skill-paths.mjs",
    "lint:permissions": "tsx tools/permission-diff.mts",
    "lint:schedule-sweeper": "tsx tools/schedule-sweeper.mts",
    "lint:migration-fence": "tsx tools/migration-fence.mts",
    "lint:migration-ledger": "tsx tools/migration-ledger.mts",
    "test:migration-ledger": "tsx --test tools/migration-ledger.test.mts",
    "lint:operation-tests": "tsx tools/operation-tests.mts",
    "test:operation-tests": "tsx --test tools/operation-tests.test.mts",
    "lint:entity-check-adoption": "tsx tools/entity-check-adoption.mts",
    "test:entity-check-adoption": "tsx --test tools/entity-check-adoption.test.mts",
    "test:schedule-sweeper": "tsx --test tools/schedule-sweeper.test.mts",
    "test:reserved-keys": "tsx --test tools/reserved-keys.test.mts",
    "store-keys": "tsx tools/store-keys.mts",
    "wire-keys": "tsx tools/wire-keys.mts",
    "test:store-keys": "tsx --test tools/store-keys.test.mts tools/wire-keys.test.mts",
    "test:permission-diff": "tsx --test tools/permission-diff.test.mts",
    "lint:model": "tsx tools/model-diff.mts",
    "lint:concept": "tsx tools/concept-lint.mts",
    "lint:export-schemas": "tsx tools/export-schema-diff.mts",
    "test:concept": "tsx --test tools/concept-lint.test.mts",
    "test:export-schemas": "tsx --test tools/export-schema-diff.test.mts",
    "lint:changeset-bump": "tsx tools/changeset-bump.mts",
    "lint:api": "tsx tools/api-diff.mts",
    "lint:client": "tsx tools/client-emit.mts",
    "lint:migrations": "pnpm -r --if-present --filter='!./.builder/projects/**' run emit:migrations",
    "lint:playbook": "tsx tools/playbook-sync.mts",
    "substrat": "node packages/cli/dist/cli.js",
    "typecheck": "pnpm -r --filter='!./.builder/projects/**' typecheck",
    "test": "pnpm run build && NODE_OPTIONS=\"$(node tools/vitest/node-options.mjs)\" pnpm -r --filter='!./.builder/projects/**' test",
    "test:affected": "node tools/test-affected.mjs",
    "docs:dev": "pnpm --filter @substrat-run/docs dev",
    "docs:build": "pnpm --filter @substrat-run/docs build",
    "docs:preview": "pnpm --filter @substrat-run/docs preview",
    "builder": "pnpm --filter @substrat-run/builder",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm lint:pins",
    "release": "pnpm run build && pnpm run lint:publish-manifests && pnpm publish -r --access public --no-git-checks && changeset tag",
    "secrets:platform": "node scripts/secrets.mjs push",
    "secrets:check": "node scripts/secrets.mjs check",
    "secrets:push": "node scripts/secrets.mjs push",
    "secrets:dev": "node scripts/secrets.mjs dev",
    "lake:provision": "node scripts/lake-provision.mjs",
    "lake:check": "node scripts/lake-provision.mjs --dry-run",
    "lake:redrain": "node scripts/lake-redrain.mjs",
    "preview:repair-pins": "node scripts/repair-preview-pins.mjs",
    "scopes:mark-copies": "node scripts/mark-copies.mjs",
    "todo-demo": "pnpm --filter @substrat-run/demo-todo",
    "lint:tests": "node tools/test-independence.mjs",
    "lint:attachment-writers": "node tools/attachment-writers.mjs",
    "lint:review-checklist": "node tools/review-checklist.mjs",
    "lint:secret-literals": "node tools/secret-literals.mjs",
    "lint:lifecycle-writes": "node tools/lifecycle-writes.mjs",
    "lint:role-seat-paths": "node tools/role-seat-paths.mjs",
    "lint:store-driver-readers": "pnpm --filter @substrat-run/control-plane-api exec vitest run --config vitest.repo.config.ts",
    "lint:store-driver-repository": "pnpm --filter @substrat-run/contracts exec vitest run --config vitest.repo.config.ts",
    "lint:floating-promises": "node tools/floating-promises.mjs",
    "test:workerd-rejections": "node --test tools/vitest/workerd-rejections.test.mjs",
    "test:preloads": "node --test tools/vitest/preloads.test.mjs",
    "lint:docs": "node tools/lint-docs.mjs",
    "lint:docs:drift": "node tools/docs-drift.mjs",
    "lint:docs:structure": "node tools/docs-structure.mjs",
    "lint:docs:surface": "node tools/docs-surface-check.mjs",
    "lint:llms": "tsx tools/llms-index.mts",
    "lint:changelog": "node tools/changelog-week.mjs",
    "lint:agent-rules": "tsx tools/agent-rules-emit.mts",
    "lint:launch": "tsx tools/launch-emit.mts",
    "lint:pins": "tsx tools/pins-emit.mts",
    "lint:platform-entry": "tsx tools/platform-entry-emit.mts",
    "lint:store-entry": "tsx tools/store-entry-emit.mts",
    "lint:worker-node-imports": "pnpm --filter @substrat-run/cli... build && node tools/worker-node-imports.mjs",
    "lint:decisions": "node tools/decisions.mjs",
    "lint:plugin": "tsx tools/plugin-emit.mts",
    "lint:connector-grants": "tsx tools/connector-grants.mts",
    "lint:conformance": "tsx tools/conformance-emit.mts",
    "lint:auth-schema": "tsx demos/auth-server/scripts/gen-schema.mts",
    "lint:scaffold": "node tools/scaffold-check.mjs",
    "fortnox:connect": "tsx connectors/fortnox/scripts/connect.mts",
    "fortnox:seed": "tsx connectors/fortnox/scripts/seed-sandbox.mts",
    "lint:wrangler-config": "node tools/wrangler-config-check.mjs",
    "lint:secrets-coverage": "node tools/secrets-coverage.mjs",
    "test:docs-union": "node --test tools/docs-union-check.test.mjs",
    "test:docs-parity": "node --test tools/docs-type-parity.test.mjs",
    "test:ci-scope": "node --test tools/ci-scope.test.mjs",
    "test:test-affected": "node --test tools/test-affected.test.mjs",
    "test:declared-deps": "node --test tools/declared-deps.test.mjs",
    "test:worker-node-imports": "pnpm --filter @substrat-run/cli... build && node --test tools/worker-node-imports.test.mjs",
    "test:repo-path": "node --test tools/repo-path.test.mjs",
    "test:override-advisories": "node --test tools/override-advisories.test.mjs",
    "lint:publish-manifests": "node tools/publish-manifests.mjs",
    "test:publish-manifests": "node --test tools/publish-manifests.test.mjs",
    "test:bare-regexp": "node --test tools/bare-regexp.test.mjs",
    "test:version-label": "node --test tools/version-label.test.mjs",
    "test:attachment-writers": "node --test tools/attachment-writers.test.mjs",
    "test:review-checklist": "node --test tools/review-checklist.test.mjs",
    "test:secret-literals": "node --test tools/secret-literals.test.mjs",
    "test:lifecycle-writes": "node --test tools/lifecycle-writes.test.mjs",
    "test:role-seat-paths": "node --test tools/role-seat-paths.test.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.11",
    "@babel/types": "^7.29.7",
    "@changesets/cli": "^2.31.0",
    "@substrat-run/contracts": "workspace:*",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "npm-package-arg": "^13.0.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "wrangler": "^4.152.0"
  }
}
