{
  "name": "substrat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "SUBSTRAT_STACK=1 VITE_DEV_ACTOR=01JZ000000000000000000C0NS concurrently -k -n stack,console -c blue,magenta \"pnpm --filter @substrat-run/demo-callout dev\" \"pnpm --filter @substrat-run/console dev\"",
    "dev:connected": "SUBSTRAT_STACK=1 CONTROL_PLANE_URL=http://127.0.0.1:8788 CP_SKIP_SEED=1 concurrently -k -n control-plane,vertical,console -c yellow,blue,magenta \"pnpm --filter @substrat-run/control-plane-api dev\" \"pnpm --filter @substrat-run/demo-callout dev\" \"pnpm --filter @substrat-run/console dev\"",
    "build": "pnpm -r --filter='!./.builder/projects/**' build",
    "lint:boundaries": "node tools/boundary-lint.mjs",
    "lint:deps": "node tools/declared-deps.mjs",
    "lint:permissions": "tsx tools/permission-diff.mts",
    "lint:model": "tsx tools/model-diff.mts",
    "lint:api": "tsx tools/api-diff.mts",
    "lint:client": "tsx tools/client-emit.mts",
    "lint:migrations": "pnpm -r --if-present --filter='!./.builder/projects/**' run emit:migrations",
    "lint:playbook": "tsx tools/playbook-sync.mts",
    "substrat": "node packages/cli/dist/cli.js",
    "typecheck": "pnpm -r --filter='!./.builder/projects/**' typecheck",
    "test": "pnpm run build && pnpm -r --filter='!./.builder/projects/**' test",
    "docs:dev": "pnpm --filter @substrat-run/docs dev",
    "docs:build": "pnpm --filter @substrat-run/docs build",
    "docs:preview": "pnpm --filter @substrat-run/docs preview",
    "callout-demo": "pnpm --filter @substrat-run/demo-callout",
    "builder": "pnpm --filter @substrat-run/builder",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm lint:pins",
    "release": "pnpm run build && pnpm publish -r --access public --no-git-checks && changeset tag",
    "secrets:platform": "tools/set-platform-secrets.sh",
    "secrets:check": "node scripts/secrets.mjs check",
    "secrets:push": "node scripts/secrets.mjs push",
    "secrets:dev": "node scripts/secrets.mjs dev",
    "todo-demo": "pnpm --filter @substrat-run/demo-todo",
    "lint:tests": "node tools/test-independence.mjs",
    "lint:docs": "node tools/lint-docs.mjs",
    "lint:docs:drift": "node tools/docs-drift.mjs",
    "lint:docs:structure": "node tools/docs-structure.mjs",
    "lint:llms": "tsx tools/llms-index.mts",
    "lint:changelog": "node tools/changelog-week.mjs",
    "lint:agent-rules": "tsx tools/agent-rules-emit.mts",
    "lint:launch": "tsx tools/launch-emit.mts",
    "lint:pins": "tsx tools/pins-emit.mts",
    "lint:decisions": "node tools/decisions.mjs",
    "lint:plugin": "tsx tools/plugin-emit.mts",
    "lint:connector-grants": "tsx tools/connector-grants.mts",
    "lint:conformance": "tsx tools/conformance-emit.mts",
    "lint:scaffold": "node tools/scaffold-check.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "wrangler": "catalog:"
  }
}
